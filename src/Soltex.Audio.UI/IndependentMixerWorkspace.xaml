<UserControl x:Class="Soltex.Audio.UI.IndependentMixerWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Soltex.Audio.UI" Background="{DynamicResource CanvasBrush}">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Audio.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,9,0,4"/></Style>
   <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Channels" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="Choose a source and an output for each channel, then shape its sound." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
   <WrapPanel x:Name="Actions">
    <Button Content="Stream mix" Click="StreamMixClicked" Style="{StaticResource CompactButton}"/>
    <Button Content="Set up microphone" Click="MicrophoneSetupClicked" Style="{StaticResource CompactButton}" AutomationProperties.Name="Set up and test microphone"/>
    <Button x:Name="StartButton" Content="Start audio" Click="StartClicked" Style="{StaticResource CompactButton}" AutomationProperties.Name="Start audio"/>
    <Button x:Name="StopButton" Content="Stop audio" Click="StopClicked" Style="{StaticResource CompactButton}" AutomationProperties.Name="Stop audio" IsEnabled="False"/>
    <Button Content="Apply changes" Click="ApplyClicked" Style="{StaticResource CompactButton}"/>
    <Button Content="Refresh devices" Click="RefreshClicked" Style="{StaticResource CompactButton}"/>
    <Button Content="Import profile" Click="ImportClicked" Style="{StaticResource CompactButton}"/>
    <Button Content="Export profile" Click="ExportClicked" Style="{StaticResource CompactButton}"/>
    <Button Content="Record / replay test" Click="ProcessingClicked" Style="{StaticResource CompactButton}"/>
   </WrapPanel>
  </StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,12,0,10" CornerRadius="4">
   <WrapPanel VerticalAlignment="Center">
    <StackPanel Width="170" Margin="0,0,20,0"><TextBlock Text="Profile" Style="{StaticResource SmallLabel}"/><TextBox x:Name="ProfileName" Text="Default" AutomationProperties.Name="Audio profile name" TextChanged="ProfileNameChanged"/></StackPanel>
    <StackPanel Width="190" Margin="0,0,20,0"><DockPanel><TextBlock Text="Master" FontWeight="SemiBold"/><TextBlock x:Name="MasterValue" Text="0.0 dB" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="MasterGain" Minimum="-80" Maximum="0" Value="0" SmallChange="1" LargeChange="5" ValueChanged="MasterChanged" PreviewMouseWheel="IgnoreWheel" AutomationProperties.Name="Master gain in decibels"/><CheckBox x:Name="MasterMute" Content="Mute playback" Checked="MasterChanged" Unchecked="MasterChanged"/></StackPanel>
    <StackPanel Width="210" Margin="0,0,20,0"><TextBlock Text="Game / Chat balance" FontWeight="SemiBold"/><Slider x:Name="Balance" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05" SmallChange="0.05" IsSnapToTickEnabled="True" ValueChanged="MasterChanged" PreviewMouseWheel="IgnoreWheel" AutomationProperties.Name="Game Chat balance"/><DockPanel><TextBlock Text="Game" Foreground="{DynamicResource MutedBrush}"/><Button Content="Center" Click="CenterClicked" Padding="8,2" HorizontalAlignment="Center"/><TextBlock Text="Chat" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></DockPanel></StackPanel>
    <StackPanel Width="220"><TextBlock Text="Playback output" Style="{StaticResource SmallLabel}"/><DockPanel><Button Content="Switch" Click="SwitchPlaybackClicked" Padding="8,3" Margin="5,0,0,0" DockPanel.Dock="Right" AutomationProperties.Name="Switch playback output" ToolTip="Moves every playback channel that is on. The microphone and device order stay as they are."/><ComboBox x:Name="PlaybackOutput" ItemsSource="{Binding OutputChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="Output for all enabled playback channels" ToolTip="{Binding SelectedItem.Label,ElementName=PlaybackOutput}"/></DockPanel></StackPanel>
   </WrapPanel>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl x:Name="ChannelItems" ItemsSource="{Binding Channels}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="220" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,8">
      <StackPanel>
       <DockPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}"/><CheckBox Content="On" IsChecked="{Binding Enabled}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Title, StringFormat='Enable {0} channel'}"/></DockPanel>
       <TextBlock Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource SmallLabel}"/>
       <ComboBox ItemsSource="{Binding CaptureChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding CaptureEndpointId,Mode=TwoWay}" ToolTip="{Binding SelectedItem.Label,RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{Binding Title, StringFormat='Source for {0}'}"/>
       <TextBlock Text="{Binding InputSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding DestinationLabel}" Style="{StaticResource SmallLabel}"/>
       <ComboBox ItemsSource="{Binding RenderChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding RenderEndpointId,Mode=TwoWay}" ToolTip="{Binding SelectedItem.Label,RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{Binding Title, StringFormat='Destination for {0}'}"/>
       <TextBlock Text="{Binding ActiveDestination}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,8" MinHeight="28"/>
       <Grid Height="110"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Slider Grid.Column="0" Style="{StaticResource FaderStyle}" Minimum="-80" Maximum="12" Value="{Binding GainDb,Mode=TwoWay}" TickFrequency="0.5" PreviewMouseWheel="IgnoreWheel" AutomationProperties.Name="{Binding Title, StringFormat='Gain in decibels for {0}'}"/>
        <local:SignalMeter Grid.Column="1" Level="{Binding Peak}" Width="10" Margin="0,7" ToolTip="Output level; blank when not measured"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBox Text="{Binding GainDb,Mode=TwoWay,UpdateSourceTrigger=LostFocus,StringFormat=F1}" HorizontalContentAlignment="Right" AutomationProperties.Name="{Binding Title, StringFormat='Numeric gain for {0}'}"/><TextBlock Text="dB" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/><CheckBox Content="Mute" IsChecked="{Binding Mute}" Margin="0,12,0,0" AutomationProperties.Name="{Binding Title, StringFormat='Mute {0}'}"/></StackPanel>
       </Grid>
       <WrapPanel Margin="0,8,0,5"><Button Content="Processing" Click="ChannelProcessingClicked" Padding="8,6" Margin="0,0,6,0"/><Button Content="Devices" Click="PolicyClicked" Padding="8,6"/></WrapPanel>
       <CheckBox Content="Pin selected device" IsChecked="{Binding ManualPin}" Margin="0,5" ToolTip="Keep the selected device preference; recover to it when available."/>
       <CheckBox Content="Return to preferred" IsChecked="{Binding AutoReturn}" Margin="0,0,0,7" ToolTip="Allow automatic return when a higher-priority output becomes available."/>
       <TextBlock Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" MinHeight="32"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0"><StackPanel><TextBlock x:Name="Feedback" Text="Connecting to audio…" TextWrapping="Wrap"/><TextBlock x:Name="RoutingHint" Text="Device choices take effect when you choose Apply changes. Faders and mute apply at once. Audio only starts when you choose Start audio." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
 </Grid>
</UserControl>
