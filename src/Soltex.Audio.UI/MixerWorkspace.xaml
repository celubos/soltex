<UserControl x:Class="Soltex.Audio.UI.MixerWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Soltex.Audio.UI" MinWidth="600" MinHeight="360" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable, Segoe UI" SizeChanged="MixerWindowSizeChanged" UseLayoutRounding="True">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Audio.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="MixerHorizontalScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="16"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{DynamicResource FieldBrush}"><Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
  </ResourceDictionary></UserControl.Resources>
  <ScrollViewer x:Name="MixerViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseWheel="MixerViewportMouseWheel" AutomationProperties.Name="Mixer workspace vertical scroll">
    <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/><ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Style="{StaticResource {x:Type ScrollBar}}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/></Grid></ControlTemplate></ScrollViewer.Template>
  <Grid x:Name="MixerLayout" Margin="26,0" MinHeight="{Binding ViewportHeight,ElementName=MixerViewport}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="76"/><RowDefinition Height="Auto" MinHeight="58"/><RowDefinition Height="*" MinHeight="380"/><RowDefinition Height="Auto" MinHeight="46"/><RowDefinition Height="154"/><RowDefinition Height="Auto" MinHeight="38"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="MixerTitle" Text="Sonar mixer" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,22,0,18"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.Column" Value="1"/><Setter Property="HorizontalAlignment" Value="Right"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactMixerLayout,RelativeSource={RelativeSource AncestorType=local:MixerWorkspace}}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,14"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="Devices" Click="DevicesClick" Margin="0,0,8,0" TabIndex="0"/><Button Content="Processing" Click="ProcessingClick" Margin="0,0,8,0" TabIndex="1"/><Button Content="Reconnect" Click="ReconnectClick" Margin="0,0,8,0" TabIndex="2"/><Button Content="Settings" Click="SettingsClick" TabIndex="3"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,4"><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Label Content="_Playback device" Target="{Binding ElementName=LinkedDevice}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Padding="0" Margin="0,0,14,0"/>
      <ComboBox x:Name="LinkedDevice" Grid.Column="1" ItemsSource="{Binding Outputs}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="LinkedDeviceChanged" VerticalAlignment="Center" MinHeight="36" IsTabStop="True" TabIndex="4" AutomationProperties.Name="Linked playback device"/>
      <TextBlock Grid.Column="2" Text="Game · Chat · Media · Aux" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="15,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsCompactMixerLayout,RelativeSource={RelativeSource AncestorType=local:MixerWorkspace}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <CheckBox x:Name="LinkOutputs" Content="Link playback outputs" IsChecked="True" Checked="LinkChanged" Unchecked="LinkChanged" TabIndex="5"><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Grid.Column" Value="3"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactMixerLayout,RelativeSource={RelativeSource AncestorType=local:MixerWorkspace}}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="0,8,0,5"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox>
    </Grid>
    <Border Grid.Row="2" Margin="0,8,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource SurfaceBrush}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="ChannelViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" ScrollChanged="ChannelViewportChanged" PreviewMouseWheel="ChannelViewportMouseWheel" AutomationProperties.Name="Channel strips, horizontally scrollable">
        <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/><ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Style="{StaticResource MixerHorizontalScrollBar}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/></Grid></ControlTemplate></ScrollViewer.Template>
        <ItemsControl x:Name="ChannelStrips" MinWidth="1140" Width="{Binding ViewportWidth,ElementName=ChannelViewport}" ItemsSource="{Binding Channels}" KeyboardNavigation.TabNavigation="Continue"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="17,17,17,15" AllowDrop="True" Drop="ChannelDrop" DragOver="ChannelDragOver">
          <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="62"/><RowDefinition Height="*" MinHeight="124"/><RowDefinition Height="38"/><RowDefinition Height="42"/><RowDefinition Height="22"/></Grid.RowDefinitions>
            <DockPanel><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Number}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="11" Margin="8,5,0,0"/></DockPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="{Binding DestinationCaption}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding DeviceId,Mode=OneWay}" DisplayMemberPath="ShortLabel" ToolTip="{Binding DeviceName}" SelectionChanged="ChannelDeviceChanged" IsEnabled="{Binding CanSelectDevice}" MinHeight="34" IsTabStop="True" AutomationProperties.Name="{Binding DeviceAccessibleName}"/></StackPanel>
            <Grid Grid.Row="2" Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Grid.Column="0" Margin="0,4,6,4"><TextBlock Text="100" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="50" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="0" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider Grid.Column="1" Style="{StaticResource FaderStyle}" Value="{Binding Level,Mode=OneWay}" ValueChanged="FaderChanged" PreviewMouseWheel="FaderWheel" IsEnabled="{Binding IsReady}" AutomationProperties.Name="{Binding FaderAccessibleName}"/><local:SignalMeter Grid.Column="2" Level="{Binding Peak}" Margin="5,4,0,4" AutomationProperties.Name="{Binding MeterAccessibleName}"/><TextBlock Grid.Column="3" Text="{Binding PeakText}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Bottom" Margin="6,0,0,4" Foreground="{DynamicResource MutedBrush}"/></Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"><TextBox Width="54" Text="{Binding LevelText,Mode=OneWay}" TextAlignment="Center" KeyDown="NumericKeyDown" LostKeyboardFocus="NumericLostFocus" AutomationProperties.Name="{Binding NumericAccessibleName}" IsEnabled="{Binding IsReady}"/><TextBlock Text="%" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
            <Button Grid.Row="4" Content="{Binding MuteLabel}" Click="MuteClick" IsEnabled="{Binding IsReady}" AutomationProperties.Name="{Binding MuteAccessibleName}" Margin="0,4,0,2"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Muted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <TextBlock Grid.Row="5" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="ChannelScrollHint" Grid.Row="1" Text="Scroll sideways to see every channel (Shift + mouse wheel)" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="12,4,12,6" Visibility="Collapsed"/>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*" MinWidth="140" MaxWidth="260"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Game / Chat" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Game" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><Slider x:Name="ChatMixSlider" Grid.Column="2" Minimum="-1" Maximum="1" Value="0" SmallChange="0.01" LargeChange="0.1" TickFrequency="0.5" TickPlacement="BottomRight" IsEnabled="False" ValueChanged="ChatMixChanged" PreviewMouseWheel="FaderWheel" VerticalAlignment="Center" AutomationProperties.Name="Game and Chat balance"/><TextBlock Grid.Column="3" Text="Chat" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}"/><Button Grid.Column="4" Content="Center" IsEnabled="{Binding IsEnabled,ElementName=ChatMixSlider}" Click="ChatMixCenter" Padding="12,5" Margin="12,0"/><TextBlock x:Name="ChatMixStatus" Text="Connecting…" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Grid.Column" Value="5"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactMixerLayout,RelativeSource={RelativeSource AncestorType=local:MixerWorkspace}}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="6"/><Setter Property="Margin" Value="0,7,0,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Applications" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Choose a channel or drag an app onto a strip" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="18,1,0,0" TextWrapping="Wrap"/></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Application routing list"><ItemsControl ItemsSource="{Binding Applications}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,5" PreviewMouseMove="ApplicationDrag"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><ComboBox Grid.Column="1" Grid.RowSpan="2" ItemsSource="{Binding Routes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding RouteId,Mode=OneWay}" SelectionChanged="ApplicationRouteChanged" VerticalAlignment="Center" MinHeight="36" AutomationProperties.Name="{Binding AccessibleName}"/><TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,3,12,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <TextBlock x:Name="EmptyApps" Grid.Row="1" Text="Play something in an app to see it here." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
    <Grid Grid.Row="5" Margin="0,6,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Connecting to Sonar…" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock x:Name="BackendNote" Text="Requires SteelSeries GG" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Grid.Column" Value="1"/><Setter Property="HorizontalAlignment" Value="Right"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactMixerLayout,RelativeSource={RelativeSource AncestorType=local:MixerWorkspace}}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,5,0,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
