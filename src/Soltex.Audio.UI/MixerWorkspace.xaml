<UserControl x:Class="Soltex.Audio.UI.MixerWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Soltex.Audio.UI"
             Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
             SizeChanged="MixerWindowSizeChanged" UseLayoutRounding="True">
  <!-- Colours and the fader come from the audio palette keys: the standalone mixer merges Themes/Audio.xaml, the suite
       points the same keys at its Studio theme (HostThemeBridge) and its own control styles apply. Every row reflows:
       actions and side controls move below when narrow, and the channel strips wrap into even rows. -->
  <UserControl.Resources>
    <Style x:Key="SonarCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SonarSecondary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SonarCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <!-- Device and route names can be long: the box trims them and its tooltip has the full name. -->
    <DataTemplate x:Key="TrimmedLabel"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
    <!-- Narrow strip boxes show the device's own name ("Headphones"); the open list and the tooltip keep the full name. -->
    <DataTemplate x:Key="CompactLabel">
      <TextBlock x:Name="Label" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue={x:Null}}" Value="{x:Null}">
          <Setter TargetName="Label" Property="Text" Value="{Binding Compact}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="TrimmedRoute"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="MixerViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                PreviewMouseWheel="MixerViewportMouseWheel" AutomationProperties.Name="Mixer workspace vertical scroll">
    <Grid x:Name="MixerLayout" Margin="24,0" MinHeight="{Binding ViewportHeight,ElementName=MixerViewport}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header: title, connection state and actions (they wrap below the title when narrow). -->
      <local:ResponsiveRow x:Name="HeaderRow" MinPrimaryWidth="240" Spacing="8" Margin="0,16,0,14">
        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
          <WrapPanel>
            <TextBlock x:Name="MixerTitle" Text="Sonar mixer" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border x:Name="ConnectionBadge" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="{DynamicResource QuietBrush}" Margin="0,2,0,2">
              <TextBlock x:Name="ConnectionText" Text="Connecting…" FontSize="12" FontWeight="SemiBold" AutomationProperties.HelpText="Sonar connection" local:LiveRegion.IsLive="True"/>
            </Border>
          </WrapPanel>
          <TextBlock x:Name="MixerSubtitle" Style="{StaticResource SonarSecondary}" FontSize="13" Margin="0,4,0,0"
                     Text="Sonar's channels, ChatMix and app routing. SteelSeries GG keeps running Sonar itself."/>
        </StackPanel>
        <!-- No TabIndex anywhere in the workspace: inside a host window, explicit indexes would jump ahead of the
             host's own controls. Document order is already the reading order. -->
        <Button Content="Devices" Click="DevicesClick" VerticalAlignment="Center" ToolTip="Which playback device Sonar's channels use, and in what order"/>
        <Button Content="Processing" Click="ProcessingClick" VerticalAlignment="Center" ToolTip="Noise reduction, equalizer and other sound processing"/>
        <Button Content="Reconnect" Click="ReconnectClick" VerticalAlignment="Center" ToolTip="Connect to Sonar again"/>
        <Button Content="Settings" Click="SettingsClick" VerticalAlignment="Center" ToolTip="Device shortcuts and other mixer settings"/>
      </local:ResponsiveRow>

      <!-- Shown when Sonar can't be reached or is off, with the next step. -->
      <Border x:Name="SonarNotice" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" AutomationProperties.Name="Sonar status">
        <local:ResponsiveRow MinPrimaryWidth="220">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="SonarNoticeTitle" Text="Sonar isn't running" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" local:LiveRegion.IsLive="True"/>
            <TextBlock x:Name="SonarNoticeText" Style="{StaticResource SonarSecondary}" FontSize="13" Margin="0,2,0,0"
                       Text="Open SteelSeries GG and turn on Sonar, then choose Try again. Your Sonar settings are kept."/>
          </StackPanel>
          <Button Content="Try again" Click="ReconnectClick" VerticalAlignment="Center"/>
        </local:ResponsiveRow>
      </Border>

      <!-- One playback device for every playback channel, and whether channels move together. -->
      <local:ResponsiveRow Grid.Row="2" MinPrimaryWidth="200" Spacing="16" Margin="0,0,0,16">
        <StackPanel MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Bottom">
          <!-- A caption like every other field caption in the audio tabs (small capitals), with its access key. -->
          <Label Content="_Playback device" Target="{Binding ElementName=LinkedDevice}" Padding="0" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold"
                 Typography.Capitals="AllSmallCaps" Foreground="{DynamicResource MutedBrush}"/>
          <Grid>
            <ComboBox x:Name="LinkedDevice" ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource TrimmedLabel}" SelectedValuePath="Id"
                      SelectionChanged="LinkedDeviceChanged" MinHeight="34" IsTabStop="True" AutomationProperties.Name="Linked playback device"
                      ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
            <TextBlock x:Name="LinkedPlaceholder" Text="Channels use different devices" ToolTip="Channels use different devices" Margin="12,0,36,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource QuietTextBrush}" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedItem, ElementName=LinkedDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </StackPanel>
        <CheckBox x:Name="LinkOutputs" Content="Link playback outputs" IsChecked="True" Checked="LinkChanged" Unchecked="LinkChanged"
                  VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTip="When on, choosing a device for one playback channel moves Game, Chat, Media and Aux together."/>
      </local:ResponsiveRow>

      <!-- Channel strips: six columns when there is room, then 3 + 3, 2 + 2 + 2 or one per row. -->
      <ItemsControl x:Name="ChannelStrips" Grid.Row="3" ItemsSource="{Binding Channels}" Focusable="False" KeyboardNavigation.TabNavigation="Continue"
                    AutomationProperties.Name="Sonar channels">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><local:AdaptiveGrid MinColumnWidth="132" ColumnSpacing="10" RowSpacing="10" StretchRows="True"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,0,12,12"
                    AllowDrop="True" Drop="ChannelDrop" DragOver="ChannelDragOver" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} channel'}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*" MinHeight="140"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="Accent" Height="3" Margin="6,0" CornerRadius="0,0,3,3" Background="{DynamicResource AccentBrush}"/>
                <DockPanel Grid.Row="1" Margin="0,12,0,0">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Number}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" Margin="6,0,0,0"/>
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                </DockPanel>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                  <TextBlock Text="{Binding DestinationCaption}" Style="{StaticResource SonarCaption}" Margin="0,0,0,4"/>
                  <ComboBox ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource CompactLabel}" SelectedValuePath="Id" SelectedValue="{Binding DeviceId,Mode=OneWay}"
                            ToolTip="{Binding DeviceName}" SelectionChanged="ChannelDeviceChanged" IsEnabled="{Binding CanSelectDevice}" MinHeight="32" IsTabStop="True"
                            AutomationProperties.Name="{Binding DeviceAccessibleName}"/>
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,12,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="Fader" Grid.Column="1" Style="{DynamicResource FaderStyle}" Orientation="Vertical" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                          IsSnapToTickEnabled="True" TickFrequency="1" Foreground="{DynamicResource AccentBrush}" Value="{Binding Level,Mode=OneWay}" ValueChanged="FaderChanged"
                          PreviewMouseWheel="FaderWheel" IsEnabled="{Binding IsReady}" AutomationProperties.Name="{Binding FaderAccessibleName}"/>
                  <local:SignalMeter Grid.Column="2" Level="{Binding Peak}" Margin="8,11,0,11" AutomationProperties.Name="{Binding MeterAccessibleName}"
                                     ToolTip="The level Windows reports for this channel"/>
                </Grid>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBox Width="58" Text="{Binding LevelText,Mode=OneWay}" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="NumericKeyDown"
                           LostKeyboardFocus="NumericLostFocus" AutomationProperties.Name="{Binding NumericAccessibleName}" IsEnabled="{Binding IsReady}"/>
                  <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <Button x:Name="MuteButton" Grid.Row="5" Content="{Binding MuteLabel}" Click="MuteClick" IsEnabled="{Binding IsReady}" Margin="0,8,0,0"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding MuteAccessibleName}"/>
                <TextBlock Grid.Row="6" Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Id}" Value="master">
                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource ChannelMasterBrush}"/>
                <Setter TargetName="Fader" Property="Foreground" Value="{DynamicResource ChannelMasterBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Id}" Value="game">
                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource ChannelGameBrush}"/>
                <Setter TargetName="Fader" Property="Foreground" Value="{DynamicResource ChannelGameBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Id}" Value="chat">
                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource ChannelChatBrush}"/>
                <Setter TargetName="Fader" Property="Foreground" Value="{DynamicResource ChannelChatBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Id}" Value="media">
                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource ChannelMediaBrush}"/>
                <Setter TargetName="Fader" Property="Foreground" Value="{DynamicResource ChannelMediaBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Id}" Value="aux">
                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource ChannelAuxBrush}"/>
                <Setter TargetName="Fader" Property="Foreground" Value="{DynamicResource ChannelAuxBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Id}" Value="mic">
                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource ChannelMicBrush}"/>
                <Setter TargetName="Fader" Property="Foreground" Value="{DynamicResource ChannelMicBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Muted}" Value="True">
                <Setter TargetName="MuteButton" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                <Setter TargetName="MuteButton" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                <Setter TargetName="MuteButton" Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ChatMix: one balance between Game and Chat. -->
      <Border Grid.Row="4" Style="{StaticResource SonarCard}" Margin="0,14,0,0" AutomationProperties.Name="ChatMix">
        <StackPanel>
          <local:ResponsiveRow MinPrimaryWidth="160" Margin="0,0,0,6" RowSpacing="2">
            <TextBlock Text="Game and Chat balance" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <TextBlock x:Name="ChatMixStatus" Text="Connecting…" Style="{StaticResource SonarSecondary}" FontSize="13" VerticalAlignment="Center" local:LiveRegion.IsLive="True"/>
          </local:ResponsiveRow>
          <local:ResponsiveRow MinPrimaryWidth="200">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Game" FontWeight="SemiBold" Foreground="{DynamicResource ChannelGameBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Slider x:Name="ChatMixSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" SmallChange="0.01" LargeChange="0.1" TickFrequency="0.5" TickPlacement="BottomRight"
                      IsEnabled="False" ValueChanged="ChatMixChanged" PreviewMouseWheel="FaderWheel" VerticalAlignment="Center" AutomationProperties.Name="Game and Chat balance"/>
              <TextBlock Grid.Column="2" Text="Chat" FontWeight="SemiBold" Foreground="{DynamicResource ChannelChatBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
            <Button Content="Center" IsEnabled="{Binding IsEnabled,ElementName=ChatMixSlider}" Click="ChatMixCenter" VerticalAlignment="Center" MinWidth="88"/>
          </local:ResponsiveRow>
        </StackPanel>
      </Border>

      <!-- Apps and the Sonar channel each one plays on. -->
      <StackPanel Grid.Row="5" Margin="0,18,0,0">
        <TextBlock Text="Applications" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
        <TextBlock Style="{StaticResource SonarSecondary}" FontSize="13" Margin="0,2,0,10" Text="Choose a channel for each app, or drag an app onto a channel."/>
        <Border Style="{StaticResource SonarCard}" Padding="16,2">
          <Grid>
            <ItemsControl x:Name="ApplicationList" ItemsSource="{Binding Applications}" Focusable="False" AutomationProperties.Name="Application routing list">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="0,10" Background="Transparent" PreviewMouseMove="ApplicationDrag">
                    <!-- Dividers between rows only: the last row ends at the card's own edge, never a second line. -->
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <local:ResponsiveRow MinPrimaryWidth="180">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock Style="{StaticResource SonarSecondary}" Margin="0,2,0,0">
                          <Run Text="{Binding Detail, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Status, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>
                      <Grid Width="200" VerticalAlignment="Center">
                        <ComboBox x:Name="Route" ItemsSource="{Binding Routes}" ItemTemplate="{StaticResource TrimmedRoute}" SelectedValuePath="Id"
                                  SelectedValue="{Binding RouteId,Mode=OneWay}" SelectionChanged="ApplicationRouteChanged" MinHeight="34"
                                  AutomationProperties.Name="{Binding AccessibleName}"/>
                        <!-- An app playing on a device outside Sonar has no channel yet. -->
                        <TextBlock Text="Choose a channel" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource QuietTextBrush}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=Route}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </local:ResponsiveRow>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyApps" Text="Play something in an app to see it here." Style="{StaticResource SonarSecondary}" FontSize="13" Margin="0,12"
                       Visibility="Collapsed"/>
          </Grid>
        </Border>
      </StackPanel>

      <local:ResponsiveRow Grid.Row="6" MinPrimaryWidth="200" Margin="0,10,0,10">
        <TextBlock x:Name="StatusText" Text="Connecting to Sonar…" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                   local:LiveRegion.IsLive="True"/>
        <TextBlock x:Name="BackendNote" Text="Requires SteelSeries GG" FontSize="12" Foreground="{DynamicResource QuietTextBrush}" VerticalAlignment="Center"/>
      </local:ResponsiveRow>
    </Grid>
  </ScrollViewer>
</UserControl>
