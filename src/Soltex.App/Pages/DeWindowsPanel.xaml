<UserControl x:Class="Soltex.App.Pages.DeWindowsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Shell.Card}" AutomationProperties.Name="De-Windows">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoAllButton" Content="Undo…" Margin="0,0,8,0" Click="UndoAll_Click"
                            AutomationProperties.Name="Undo the De-Windows changes" />
                    <Button x:Name="ReviewButton" Style="{StaticResource Studio.PrimaryButton}" Content="Review…" Click="Review_Click"
                            AutomationProperties.Name="Review the De-Windows changes" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Shell.CardTitle}" Text="De-Windows" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
            <StackPanel x:Name="PlanPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <ItemsControl x:Name="PlanList" Focusable="False" AutomationProperties.Name="Changes that will be made">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" Margin="0,4" Content="{Binding Title}" AutomationProperties.Name="{Binding Title}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ApplyPlanButton" Style="{StaticResource Studio.PrimaryButton}" Content="Apply" Margin="0,0,8,0" Click="ApplyPlan_Click" />
                    <Button x:Name="CancelPlanButton" Content="Cancel" Click="CancelPlan_Click" />
                </StackPanel>
            </StackPanel>
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.Name="Applying changes" />
        </StackPanel>
    </Border>
</UserControl>
