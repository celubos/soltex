<UserControl x:Class="Soltex.App.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The same page frame as every other page: one scroll host at the window edge, Shell.PagePadding inside it (the
         shell narrows it in a narrow window) and a content column capped at Shell.PageMaxWidth, so the column starts and
         ends where every other page's does and is the same on every tab. Below the narrowest usable width the page
         scrolls sideways (with its scroll bar showing) instead of crushing the controls. -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                  SizeChanged="PageScroll_SizeChanged">
        <Grid x:Name="PageContent" Margin="{DynamicResource Shell.PagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{DynamicResource Shell.PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Shell.PageTitle}" Text="Audio" />
                <!-- True whether audio is on or off, and consistent with the Mixer's Stop audio button. -->
                <TextBlock x:Name="Intro" Style="{StaticResource Shell.PageSubtitle}" Margin="0,0,0,16"
                           Text="Closing this window doesn't stop audio. To stop it, choose Stop audio on the Mixer, or Quit from the tray icon." />
            </StackPanel>
            <ListBox x:Name="Tabs" Grid.Row="1" Margin="0,0,0,18" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"
                     AutomationProperties.Name="Audio sections" SelectionChanged="Tabs_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <!-- Room below each tab, so tabs that wrap onto a second line never touch. -->
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Studio.SegmentItem}">
                        <Setter Property="Margin" Value="0,0,6,6" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2">
                <ContentControl x:Name="MicHost" Focusable="False" IsTabStop="False" />
                <ContentControl x:Name="PlaybackHost" Focusable="False" IsTabStop="False" Visibility="Collapsed" />
                <ContentControl x:Name="AppsHost" Focusable="False" IsTabStop="False" Visibility="Collapsed" />
                <ContentControl x:Name="SonarHost" Focusable="False" IsTabStop="False" Visibility="Collapsed" />
                <TextBlock x:Name="LoadingText" Style="{StaticResource Shell.Secondary}" Margin="0,4,0,0" Text="Connecting to audio…" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
