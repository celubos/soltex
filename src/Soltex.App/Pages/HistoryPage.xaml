<UserControl x:Class="Soltex.App.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="{DynamicResource Shell.PagePadding}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="900" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Shell.PageTitle}" Text="History" />
            <TextBlock x:Name="Intro" Style="{StaticResource Shell.PageSubtitle}"
                       Text="Changes this app made to Windows, newest first. Undo puts back what was there before, unless you or another app changed it since. Full De-Windows changes are undone on Home." />
            <Border Style="{StaticResource Shell.Card}">
                <StackPanel>
                    <DockPanel x:Name="HeaderRow" Margin="0,0,0,8">
                        <Button x:Name="UndoAllButton" DockPanel.Dock="Right" Content="Undo all…" Click="UndoAll_Click"
                                AutomationProperties.HelpText="Undo every setting change listed here that can still be undone. Full De-Windows changes are undone on Home." />
                        <TextBlock x:Name="Summary" Style="{StaticResource Shell.Body}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Shell.Secondary}"
                               Text="No changes yet. Changes you make on Home, Taskbar, Start, File Explorer, Appearance, Multitasking and Privacy appear here." />
                    <ItemsControl x:Name="ChangeList" Focusable="False" AutomationProperties.Name="Changes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Shell.Secondary}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Shell.Body}" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Shell.Secondary}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Undo" Tag="{Binding SettingId}" Visibility="{Binding UndoVisibility}"
                                            AutomationProperties.Name="{Binding UndoName}" Click="Undo_Click" VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
