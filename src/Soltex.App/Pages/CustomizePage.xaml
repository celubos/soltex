<UserControl x:Class="Soltex.App.Pages.CustomizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audio="clr-namespace:Soltex.Audio.UI;assembly=Soltex.Audio.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="{DynamicResource Shell.PagePadding}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{DynamicResource Shell.PageMaxWidth}" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
            <DockPanel Margin="0,0,0,20">
                <!-- Windows Settings' own page for this area. -->
                <TextBlock x:Name="SettingsLinkText" DockPanel.Dock="Right" Style="{StaticResource Shell.Secondary}" TextWrapping="NoWrap"
                           VerticalAlignment="Bottom" Margin="16,0,0,6" Visibility="Collapsed">
                    <Hyperlink x:Name="SettingsLink" Click="SettingsLink_Click" AutomationProperties.Name="More in Windows Settings">More in Windows Settings</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="PageTitleText" Style="{StaticResource Shell.PageTitle}" Margin="0" />
            </DockPanel>

            <Border x:Name="RestartBar" Style="{StaticResource Studio.Row}" Visibility="Collapsed" Margin="0,0,0,16">
                <!-- The button moves below the text when the page is narrow. -->
                <audio:ResponsiveRow MinPrimaryWidth="200" Spacing="16">
                    <TextBlock Style="{StaticResource Shell.Body}" VerticalAlignment="Center" Text="Some changes show after File Explorer restarts." />
                    <Button x:Name="RestartExplorer" Content="Restart File Explorer" VerticalAlignment="Center" Click="RestartExplorer_Click"
                            AutomationProperties.HelpText="The taskbar and File Explorer windows close and reopen; your files are not affected" />
                </audio:ResponsiveRow>
            </Border>
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.Name="Applying changes" />

            <StackPanel x:Name="Groups" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
