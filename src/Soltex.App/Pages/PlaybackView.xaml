<UserControl x:Class="Soltex.App.Pages.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Soltex.App.Controls"
             xmlns:pages="clr-namespace:Soltex.App.Pages"
             xmlns:audio="clr-namespace:Soltex.Audio.UI;assembly=Soltex.Audio.UI">
    <UserControl.Resources>
        <controls:BusBrushConverter x:Key="BusBrush" />
        <controls:BusGlyphConverter x:Key="BusGlyph" />
        <controls:DecibelTextConverter x:Key="DecibelText" />

        <!-- Strips share one card look; width comes from the grid they wrap in, height from their content. -->
        <Style x:Key="StripCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource Studio.CardBrush}" />
        </Style>
        <Style x:Key="StripLabel" TargetType="TextBlock" BasedOn="{StaticResource Studio.Eyebrow}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="StripTitle" TargetType="TextBlock" BasedOn="{StaticResource Shell.CardTitle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="GlyphTile" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Studio.HoverBrush}" />
        </Style>
        <!-- Long device names are trimmed in the box; its tooltip has the full name. -->
        <DataTemplate x:Key="TrimmedLabel">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!-- A playback channel: identity, state, fader + meter, level, routing, sound. -->
        <DataTemplate x:Key="ChannelStrip">
            <Border Style="{StaticResource StripCard}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} channel'}">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" Margin="18,0" CornerRadius="0,0,3,3" Background="{Binding Bus, Converter={StaticResource BusBrush}}" />
                    <DockPanel Margin="14,16,14,14">
                        <DockPanel DockPanel.Dock="Top">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Studio.Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="8,0,0,0"
                                      AutomationProperties.Name="{Binding Title, StringFormat='{}{0} channel on'}" ToolTip="Channel on or off" />
                            <Border Style="{StaticResource GlyphTile}">
                                <TextBlock Style="{StaticResource Shell.Glyph}" Text="{Binding Bus, Converter={StaticResource BusGlyph}}" FontSize="14"
                                           Foreground="{Binding Bus, Converter={StaticResource BusBrush}}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource StripTitle}" ToolTip="{Binding Title}" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0" ToolTip="{Binding Reason}">
                            <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="1,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Studio.TextTertiaryBrush}" />
                            <TextBlock x:Name="StateLine" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding State}" Foreground="{DynamicResource Studio.TextSecondaryBrush}" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <controls:EqCurve Height="26" Settings="{Binding Dsp}" Stroke="{Binding Bus, Converter={StaticResource BusBrush}}"
                                              Guide="{DynamicResource Studio.StrokeBrush}" Margin="0,0,0,10" ToolTip="Equalizer shape" />
                            <UniformGrid Columns="2">
                                <CheckBox Style="{StaticResource Studio.TogglePill}" Content="Mute" IsChecked="{Binding Mute}" Margin="0,0,4,0"
                                          AutomationProperties.Name="{Binding Title, StringFormat='Mute {0}'}" />
                                <Button Content="Sound" Margin="4,0,0,0" Padding="8,6" MinHeight="0" Click="Sound_Click"
                                        AutomationProperties.Name="{Binding Title, StringFormat='Adjust {0} sound'}" ToolTip="Equalizer, noise and stereo for this channel" />
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Style="{StaticResource StripLabel}" Text="Source" />
                            <ComboBox Style="{StaticResource Studio.CompactCombo}" ItemsSource="{Binding CaptureChoices}" ItemTemplate="{StaticResource TrimmedLabel}" SelectedValuePath="Id"
                                      SelectedValue="{Binding CaptureEndpointId, Mode=TwoWay}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                                      AutomationProperties.Name="{Binding Title, StringFormat='Source for {0}'}" />
                            <TextBlock Style="{StaticResource StripLabel}" Text="Plays on" />
                            <ComboBox Style="{StaticResource Studio.CompactCombo}" ItemsSource="{Binding RenderChoices}" ItemTemplate="{StaticResource TrimmedLabel}" SelectedValuePath="Id"
                                      SelectedValue="{Binding RenderEndpointId, Mode=TwoWay}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                                      AutomationProperties.Name="{Binding Title, StringFormat='Output for {0}'}" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0" Height="232">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Slider Style="{StaticResource Studio.Fader}" Minimum="-80" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        SmallChange="0.5" LargeChange="3" Value="{Binding GainDb, Mode=TwoWay}" Foreground="{Binding Bus, Converter={StaticResource BusBrush}}"
                                        AutomationProperties.Name="{Binding Title, StringFormat='{}{0} level in decibels'}" />
                                <audio:SignalMeter Margin="10,11,0,11" Level="{Binding Peak}" Fill="{DynamicResource Studio.MeterBrush}" Track="{DynamicResource Studio.TrackBrush}"
                                                   ToolTip="Output level, with the recent peak; empty when not measured" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="{Binding GainDb, Converter={StaticResource DecibelText}}" FontSize="20" FontWeight="Bold"
                                           FontFamily="{StaticResource Studio.DisplayFont}" Foreground="{DynamicResource Studio.TextBrush}" />
                                <TextBlock Text=" dB" FontSize="12" Foreground="{DynamicResource Studio.TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Studio.SuccessBrush}" />
                    <Setter TargetName="StateLine" Property="Foreground" Value="{DynamicResource Studio.SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Studio.CriticalBrush}" />
                    <Setter TargetName="StateLine" Property="Foreground" Value="{DynamicResource Studio.CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter TargetName="StateLine" Property="Text" Value="Off" />
                    <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Studio.TrackBrush}" />
                    <Setter TargetName="StateLine" Property="Foreground" Value="{DynamicResource Studio.TextTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The microphone: what other apps hear and where it comes from; set up on the Microphone tab. -->
        <DataTemplate x:Key="MicStrip">
            <Border Style="{StaticResource StripCard}" AutomationProperties.Name="Microphone channel">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" Margin="18,0" CornerRadius="0,0,3,3" Background="{DynamicResource Studio.Channel.Microphone}" />
                    <DockPanel Margin="14,16,14,14">
                        <DockPanel DockPanel.Dock="Top" MinHeight="24">
                            <Border Style="{StaticResource GlyphTile}">
                                <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE720;" FontSize="14" Foreground="{DynamicResource Studio.Channel.Microphone}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Mic" Style="{StaticResource StripTitle}" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0" ToolTip="{Binding Mic.Explanation, RelativeSource={RelativeSource AncestorType=pages:PlaybackView}}">
                            <Ellipse Width="7" Height="7" Margin="1,0,7,0" VerticalAlignment="Center" Fill="{Binding Mic.StateBrush, RelativeSource={RelativeSource AncestorType=pages:PlaybackView}}" />
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Mic.State, RelativeSource={RelativeSource AncestorType=pages:PlaybackView}}"
                                       Foreground="{DynamicResource Studio.TextSecondaryBrush}" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <controls:EqCurve Height="26" Settings="{Binding Dsp}" Stroke="{DynamicResource Studio.Channel.Microphone}" Guide="{DynamicResource Studio.StrokeBrush}"
                                              Margin="0,0,0,10" ToolTip="Equalizer shape" />
                            <UniformGrid Columns="2">
                                <CheckBox Style="{StaticResource Studio.TogglePill}" Content="Mute" IsChecked="{Binding Mute}" Margin="0,0,4,0" AutomationProperties.Name="Mute microphone" />
                                <Button Content="Setup" Margin="4,0,0,0" Padding="8,6" MinHeight="0" Click="MicSetup_Click" AutomationProperties.Name="Open microphone setup"
                                        ToolTip="Choose the microphone, test it and pick its sound" />
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Style="{StaticResource StripLabel}" Text="Apps hear it as" />
                            <Border Style="{StaticResource Studio.Chip}" HorizontalAlignment="Stretch" Padding="9,6" MinHeight="30"
                                    ToolTip="{Binding Mic.Receiving, RelativeSource={RelativeSource AncestorType=pages:PlaybackView}}">
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Studio.TextBrush}"
                                           Text="{Binding Mic.Receiving, RelativeSource={RelativeSource AncestorType=pages:PlaybackView}}" />
                            </Border>
                            <TextBlock Style="{StaticResource StripLabel}" Text="From" />
                            <Border Style="{StaticResource Studio.Chip}" HorizontalAlignment="Stretch" Padding="9,6" MinHeight="30"
                                    ToolTip="{Binding Mic.SourceDetail, RelativeSource={RelativeSource AncestorType=pages:PlaybackView}}">
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Studio.TextBrush}"
                                           Text="{Binding Mic.Source, RelativeSource={RelativeSource AncestorType=pages:PlaybackView}}" />
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,12,0,0" Height="232">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Slider Style="{StaticResource Studio.Fader}" Minimum="-80" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="3"
                                        Value="{Binding GainDb, Mode=TwoWay}" Foreground="{DynamicResource Studio.Channel.Microphone}" AutomationProperties.Name="Microphone level in decibels" />
                                <audio:SignalMeter Margin="10,11,0,11" Level="{Binding Peak}" Fill="{DynamicResource Studio.MeterBrush}" Track="{DynamicResource Studio.TrackBrush}"
                                                   ToolTip="Microphone level after processing, with the recent peak; empty when not measured" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="{Binding GainDb, Converter={StaticResource DecibelText}}" FontSize="20" FontWeight="Bold"
                                           FontFamily="{StaticResource Studio.DisplayFont}" Foreground="{DynamicResource Studio.TextBrush}" />
                                <TextBlock Text=" dB" FontSize="12" Foreground="{DynamicResource Studio.TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <pages:ChannelStripSelector x:Key="StripSelector" Microphone="{StaticResource MicStrip}" Playback="{StaticResource ChannelStrip}" />
    </UserControl.Resources>

    <!-- The Audio page is the scroll host; this view only lays out its content. -->
    <StackPanel Margin="0,0,0,8">
        <!-- Section heading: what this is, whether audio runs, and the one main action. -->
        <audio:ResponsiveRow MinPrimaryWidth="220" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Shell.SectionTitle}" Margin="0" Text="Mixer" />
                <TextBlock Style="{StaticResource Shell.Secondary}" Margin="0,4,0,0"
                           Text="Each channel has its own source, output and sound. New sources and outputs wait until you apply them." />
            </StackPanel>
            <Border x:Name="StateBadge" CornerRadius="10" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <TextBlock x:Name="StateText" Style="{StaticResource Shell.Body}" FontWeight="SemiBold" TextWrapping="NoWrap" Text="Connecting…"
                           AutomationProperties.HelpText="Audio state" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Button x:Name="StartStopButton" Style="{StaticResource Studio.PrimaryButton}" Content="Start audio" MinWidth="128" VerticalAlignment="Center"
                    Click="StartStopButton_Click" />
        </audio:ResponsiveRow>

        <!-- Overall: level, game/chat balance and a one-click output switch, in as many columns as fit. -->
        <Border Style="{StaticResource Shell.Card}" AutomationProperties.Name="Overall">
            <audio:AdaptiveGrid MinColumnWidth="220" MaxColumns="3" ColumnSpacing="28" RowSpacing="20" Balanced="False">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="MasterValue" DockPanel.Dock="Right" Style="{StaticResource Shell.Secondary}" FontWeight="SemiBold" TextWrapping="NoWrap" Margin="8,0,0,0" />
                        <TextBlock Style="{StaticResource Studio.Eyebrow}" Text="Overall level" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider x:Name="MasterSlider" Minimum="-80" Maximum="0" SmallChange="1" LargeChange="5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Overall playback level" ValueChanged="MasterSlider_ValueChanged" Margin="0,8,0,6" />
                    <CheckBox x:Name="MasterMuteBox" Style="{StaticResource Studio.Switch}" Content="Mute all" Checked="MasterMute_Changed" Unchecked="MasterMute_Changed"
                              AutomationProperties.Name="Mute all playback" />
                </StackPanel>
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="BalanceValue" DockPanel.Dock="Right" Style="{StaticResource Shell.Secondary}" FontWeight="SemiBold" TextWrapping="NoWrap" Margin="8,0,0,0" />
                        <TextBlock Style="{StaticResource Studio.Eyebrow}" Text="Balance" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider x:Name="BalanceSlider" Minimum="-1" Maximum="1" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Game and chat balance" ValueChanged="BalanceSlider_ValueChanged" Margin="0,8,0,2" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Chat" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Studio.Channel.Chat}" />
                        <TextBlock Text="Game" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Studio.Channel.Game}" />
                    </DockPanel>
                    <TextBlock x:Name="BalanceHint" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Studio.Eyebrow}" Text="Play every channel on" TextWrapping="Wrap" />
                    <audio:ResponsiveRow MinPrimaryWidth="120" Spacing="8" RowSpacing="8" Margin="0,8,0,0">
                        <Grid>
                            <ComboBox x:Name="OutputChoice" ItemTemplate="{StaticResource TrimmedLabel}" SelectedValuePath="Id" SelectionChanged="OutputChoice_SelectionChanged"
                                      AutomationProperties.Name="Output for every playback channel" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" />
                            <!-- Placeholder while nothing is chosen (channels on different outputs, or none on). -->
                            <TextBlock Text="Choose an output" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" ToolTip="Choose an output"
                                       Foreground="{DynamicResource Studio.TextTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=OutputChoice}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="SwitchOutput" Content="Switch" Click="SwitchOutput_Click" IsEnabled="False" VerticalAlignment="Top"
                                AutomationProperties.Name="Switch every playback channel to this output" />
                    </audio:ResponsiveRow>
                    <TextBlock Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,6,0,0"
                               Text="Moves Game, Chat, Media and Aux together. The microphone stays where it is." />
                </StackPanel>
            </audio:AdaptiveGrid>
        </Border>

        <!-- No connection to the audio engine: say why and offer the next step. -->
        <Border x:Name="OfflineBar" Style="{StaticResource Shell.InfoBar}" Tag="Critical" Visibility="Collapsed" AutomationProperties.Name="Audio isn't connected">
            <audio:ResponsiveRow MinPrimaryWidth="220">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Text="Audio isn't connected" />
                    <TextBlock x:Name="OfflineReason" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" VerticalAlignment="Center" AutomationProperties.Name="Try connecting to audio again" />
            </audio:ResponsiveRow>
        </Border>

        <!-- Staged routing stays above the strips so it is seen before anything else on a narrow window. -->
        <Border x:Name="StagedBar" Style="{StaticResource Shell.InfoBar}" Tag="Caution" Visibility="Collapsed" AutomationProperties.Name="Unsaved channel changes">
            <audio:ResponsiveRow MinPrimaryWidth="220">
                <TextBlock Style="{StaticResource Shell.Body}" VerticalAlignment="Center"
                           Text="You changed a source, output or channel switch. Choose Apply changes to use it. Until then, audio keeps the previous setup." />
                <Button x:Name="ApplyButton" Style="{StaticResource Studio.PrimaryButton}" Content="Apply changes" Click="ApplyButton_Click" VerticalAlignment="Center" />
            </audio:ResponsiveRow>
        </Border>

        <!-- Microphone and the four playback channels: one row when there is room, otherwise even rows (3 + 2, 2 + 2 + 1). -->
        <ItemsControl x:Name="ChannelList" Focusable="False" ItemTemplateSelector="{StaticResource StripSelector}" AutomationProperties.Name="Channels" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <audio:AdaptiveGrid MinColumnWidth="164" MaxColumnWidth="280" ColumnSpacing="12" RowSpacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock x:Name="StatusLine" Style="{StaticResource Shell.Secondary}" Margin="2,0,0,12" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel>
            <Button Content="Stream mix…" Margin="0,0,8,8" Click="StreamMix_Click" AutomationProperties.Name="Separate mix for streaming"
                    ToolTip="A second mix for OBS or other streaming apps" />
            <Button Content="Import profile…" Margin="0,0,8,8" Click="Import_Click" />
            <Button Content="Export profile…" Margin="0,0,8,8" Click="Export_Click" />
            <Button Content="Device order…" Margin="0,0,8,8" Click="DeviceOrderMenu_Click" AutomationProperties.Name="Device order for a channel"
                    ToolTip="Which output a channel moves to when its device is unplugged" />
        </WrapPanel>
    </StackPanel>
</UserControl>
