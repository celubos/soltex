<UserControl x:Class="Soltex.App.Pages.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Soltex.App.Controls">
    <UserControl.Resources>
        <controls:BusBrushConverter x:Key="BusBrush" />
        <controls:BusGlyphConverter x:Key="BusGlyph" />
        <controls:PeakLevelConverter x:Key="PeakLevel" />
        <controls:DecibelTextConverter x:Key="DecibelText" />

        <Style x:Key="StripCard" TargetType="Border">
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="528" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource Studio.CardBrush}" />
        </Style>
        <Style x:Key="StripLabel" TargetType="TextBlock" BasedOn="{StaticResource Studio.Eyebrow}">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <!-- One channel strip: identity, state, fader + meter, level, routing, sound. -->
        <DataTemplate x:Key="ChannelStrip">
            <Border Style="{StaticResource StripCard}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} channel'}">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" Margin="18,0" CornerRadius="0,0,3,3" Background="{Binding Bus, Converter={StaticResource BusBrush}}" />
                    <DockPanel Margin="14,16,14,14">
                        <DockPanel DockPanel.Dock="Top">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Studio.Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Title, StringFormat='{}{0} channel on'}" ToolTip="Channel on or off" />
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Studio.HoverBrush}">
                                <TextBlock Style="{StaticResource Shell.Glyph}" Text="{Binding Bus, Converter={StaticResource BusGlyph}}" FontSize="15"
                                           Foreground="{Binding Bus, Converter={StaticResource BusBrush}}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Shell.CardTitle}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Height="18"
                                   ToolTip="{Binding Reason}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding State}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter Property="Text" Value="Off" />
                                            <Setter Property="Foreground" Value="{DynamicResource Studio.TextTertiaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Foreground" Value="{DynamicResource Studio.SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <controls:EqCurve Height="26" Settings="{Binding Dsp}" Stroke="{Binding Bus, Converter={StaticResource BusBrush}}"
                                              Guide="{DynamicResource Studio.StrokeBrush}" Margin="0,0,0,8" ToolTip="Equalizer shape" />
                            <UniformGrid Columns="2">
                                <CheckBox Style="{StaticResource Studio.TogglePill}" Content="Mute" IsChecked="{Binding Mute}" Margin="0,0,4,0"
                                          AutomationProperties.Name="{Binding Title, StringFormat='Mute {0}'}" />
                                <Button Content="Sound" Margin="4,0,0,0" Padding="8,6" MinHeight="0" Click="Sound_Click"
                                        AutomationProperties.Name="{Binding Title, StringFormat='Adjust {0} sound'}" />
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Style="{StaticResource StripLabel}" Text="Source" />
                            <ComboBox Style="{StaticResource Studio.CompactCombo}" ItemsSource="{Binding CaptureChoices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                      SelectedValue="{Binding CaptureEndpointId, Mode=TwoWay}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                                      AutomationProperties.Name="{Binding Title, StringFormat='Source for {0}'}" />
                            <TextBlock Style="{StaticResource StripLabel}" Text="Plays on" />
                            <ComboBox Style="{StaticResource Studio.CompactCombo}" ItemsSource="{Binding RenderChoices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                      SelectedValue="{Binding RenderEndpointId, Mode=TwoWay}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                                      AutomationProperties.Name="{Binding Title, StringFormat='Output for {0}'}" />
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Slider Style="{StaticResource Studio.Fader}" Minimum="-80" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        SmallChange="0.5" LargeChange="3" Value="{Binding GainDb, Mode=TwoWay}" Foreground="{Binding Bus, Converter={StaticResource BusBrush}}"
                                        AutomationProperties.Name="{Binding Title, StringFormat='{}{0} level in decibels'}" />
                                <controls:LevelMeter Width="8" Margin="10,11,0,11" Level="{Binding Peak, Converter={StaticResource PeakLevel}}"
                                                     Fill="{DynamicResource Studio.MeterBrush}" Track="{DynamicResource Studio.TrackBrush}"
                                                     ToolTip="Output level; empty when not measured" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="{Binding GainDb, Converter={StaticResource DecibelText}}" FontSize="20" FontWeight="Bold"
                                           FontFamily="{StaticResource Studio.DisplayFont}" Foreground="{DynamicResource Studio.TextBrush}" />
                                <TextBlock Text=" dB" FontSize="12" Foreground="{DynamicResource Studio.TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The Audio page is the scroll host; this view only lays out its content. -->
    <StackPanel Margin="0,0,0,8">
        <!-- Overall: level, game/chat balance, one-click output switch, start/stop. -->
        <Border Style="{StaticResource Shell.Card}" AutomationProperties.Name="Overall">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <DockPanel>
                        <TextBlock x:Name="MasterValue" DockPanel.Dock="Right" Style="{StaticResource Shell.Secondary}" />
                        <TextBlock Style="{StaticResource Studio.Eyebrow}" Text="Overall level" />
                    </DockPanel>
                    <Slider x:Name="MasterSlider" Minimum="-80" Maximum="0" SmallChange="1" LargeChange="5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Overall playback level" ValueChanged="MasterSlider_ValueChanged" Margin="0,6,0,4" />
                    <CheckBox x:Name="MasterMuteBox" Style="{StaticResource Studio.Switch}" Content="Mute all" Checked="MasterMute_Changed" Unchecked="MasterMute_Changed"
                              AutomationProperties.Name="Mute all playback" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource Studio.Eyebrow}" Text="Game and chat balance" />
                    <Slider x:Name="BalanceSlider" Minimum="-1" Maximum="1" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Game and chat balance" ValueChanged="BalanceSlider_ValueChanged" Margin="0,6,0,0" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Chat" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Studio.Channel.Chat}" />
                        <TextBlock Text="Game" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Studio.Channel.Game}" />
                    </DockPanel>
                    <TextBlock x:Name="BalanceHint" Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource Studio.Eyebrow}" Text="Play every channel on" />
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="SwitchOutput" DockPanel.Dock="Right" Content="Switch" Margin="8,0,0,0" Click="SwitchOutput_Click" IsEnabled="False"
                                AutomationProperties.Name="Switch every playback channel to this output" />
                        <Grid>
                            <ComboBox x:Name="OutputChoice" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="OutputChoice_SelectionChanged"
                                      AutomationProperties.Name="Output for every playback channel" />
                            <!-- Placeholder while nothing is chosen (channels on different outputs, or none on). -->
                            <TextBlock Text="Choose an output" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Studio.TextTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=OutputChoice}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Moves Game, Chat, Media and Aux together. The microphone stays where it is." />
                </StackPanel>
                <Button x:Name="StartStopButton" Grid.Column="3" Style="{StaticResource Studio.PrimaryButton}" Content="Start audio" MinWidth="128"
                        VerticalAlignment="Center" Click="StartStopButton_Click" />
            </Grid>
        </Border>

        <!-- The mixer: microphone, the four playback channels, and the overall output. -->
        <ScrollViewer x:Name="StripScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,14"
                      PreviewMouseWheel="StripScroll_PreviewMouseWheel">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="MicStrip" Style="{StaticResource StripCard}" AutomationProperties.Name="Microphone channel">
                    <Grid>
                        <Border Height="3" VerticalAlignment="Top" Margin="18,0" CornerRadius="0,0,3,3" Background="{DynamicResource Studio.Channel.Microphone}" />
                        <DockPanel Margin="14,16,14,14">
                            <DockPanel DockPanel.Dock="Top">
                                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Studio.HoverBrush}">
                                    <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE720;" FontSize="15" Foreground="{DynamicResource Studio.Channel.Microphone}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Mic" Style="{StaticResource Shell.CardTitle}" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="MicState" DockPanel.Dock="Top" FontSize="12" Margin="0,8,0,0" Height="18" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Studio.TextSecondaryBrush}" />
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <controls:EqCurve x:Name="MicCurve" Height="26" Stroke="{DynamicResource Studio.Channel.Microphone}" Guide="{DynamicResource Studio.StrokeBrush}" Margin="0,0,0,8" />
                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="MicMute" Style="{StaticResource Studio.TogglePill}" Content="Mute" Margin="0,0,4,0" AutomationProperties.Name="Mute microphone" />
                                    <Button Content="Setup" Margin="4,0,0,0" Padding="8,6" MinHeight="0" Click="MicSetup_Click" AutomationProperties.Name="Open microphone setup" />
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <TextBlock Style="{StaticResource StripLabel}" Text="Apps hear it as" />
                                <Border Style="{StaticResource Studio.Chip}" HorizontalAlignment="Stretch" Padding="9,6">
                                    <TextBlock x:Name="MicReceiving" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Studio.TextBrush}" />
                                </Border>
                                <TextBlock Style="{StaticResource StripLabel}" Text="From" />
                                <Border Style="{StaticResource Studio.Chip}" HorizontalAlignment="Stretch" Padding="9,6">
                                    <TextBlock x:Name="MicSource" FontSize="12" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Studio.TextBrush}" />
                                </Border>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Slider x:Name="MicFader" Style="{StaticResource Studio.Fader}" Minimum="-80" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            SmallChange="0.5" LargeChange="3" Foreground="{DynamicResource Studio.Channel.Microphone}" AutomationProperties.Name="Microphone level in decibels" />
                                    <controls:LevelMeter x:Name="MicMeter" Width="8" Margin="10,11,0,11" Fill="{DynamicResource Studio.MeterBrush}" Track="{DynamicResource Studio.TrackBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <TextBlock x:Name="MicValue" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Studio.DisplayFont}" Foreground="{DynamicResource Studio.TextBrush}" />
                                    <TextBlock Text=" dB" FontSize="12" Foreground="{DynamicResource Studio.TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Border>
                <ItemsControl x:Name="ChannelList" Focusable="False" ItemTemplate="{StaticResource ChannelStrip}" AutomationProperties.Name="Playback channels">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="StagedBar" Style="{StaticResource Shell.InfoBar}" Tag="Caution" Visibility="Collapsed" AutomationProperties.Name="Unsaved channel changes">
            <DockPanel>
                <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource Studio.PrimaryButton}" Content="Apply changes" Click="ApplyButton_Click" Margin="12,0,0,0" />
                <TextBlock Style="{StaticResource Shell.Body}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="You changed a source, output or channel switch. Choose Apply changes to use it. Until then, audio keeps the previous setup." />
            </DockPanel>
        </Border>
        <TextBlock x:Name="StatusLine" Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="2,0,0,10" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel>
            <Button Content="Stream mix…" Margin="0,0,8,8" Click="StreamMix_Click" AutomationProperties.Name="Separate mix for streaming" />
            <Button Content="Import profile…" Margin="0,0,8,8" Click="Import_Click" />
            <Button Content="Export profile…" Margin="0,0,8,8" Click="Export_Click" />
            <Button Content="Device order…" Margin="0,0,8,8" Click="DeviceOrderMenu_Click" AutomationProperties.Name="Device order for a channel" />
        </WrapPanel>
    </StackPanel>
</UserControl>
