<UserControl x:Class="Soltex.App.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="{DynamicResource Shell.PagePadding}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="900" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock x:Name="Intro" Style="{StaticResource Shell.PageTitle}" Text="Tools" Margin="0,0,0,20" />

            <!-- Utilities -->
            <TextBlock Style="{StaticResource Shell.CardTitle}" Text="Utilities" Margin="2,0,0,8" />
            <Border Style="{StaticResource Studio.Row}">
                <DockPanel>
                    <CheckBox x:Name="KeepAwakeSwitch" DockPanel.Dock="Right" Style="{StaticResource Studio.Switch}" VerticalAlignment="Center"
                              Checked="KeepAwake_Changed" Unchecked="KeepAwake_Changed" AutomationProperties.Name="Keep awake" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Shell.Body}" Text="Keep awake" />
                        <TextBlock Style="{StaticResource Shell.Secondary}" FontSize="12" Text="Until you turn it off or quit" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Studio.Row}">
                <DockPanel>
                    <CheckBox x:Name="AlwaysOnTopSwitch" DockPanel.Dock="Right" Style="{StaticResource Studio.Switch}" VerticalAlignment="Center"
                              Checked="Shortcut_Changed" Unchecked="Shortcut_Changed" AutomationProperties.Name="Always on top shortcut" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Shell.Body}" Text="Always on top" />
                        <TextBlock x:Name="AlwaysOnTopNote" Style="{StaticResource Shell.Secondary}" FontSize="12" Text="Win+Ctrl+T pins the active window" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Studio.Row}" Margin="0,0,0,24">
                <DockPanel>
                    <CheckBox x:Name="ColorPickerSwitch" DockPanel.Dock="Right" Style="{StaticResource Studio.Switch}" VerticalAlignment="Center"
                              Checked="Shortcut_Changed" Unchecked="Shortcut_Changed" AutomationProperties.Name="Color picker shortcut" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Shell.Body}" Text="Color picker" />
                        <TextBlock x:Name="ColorPickerNote" Style="{StaticResource Shell.Secondary}" FontSize="12" Text="Win+Shift+C copies the color under the pointer" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MoreTools" Focusable="False" Margin="0,0,0,14" />
            <ContentControl x:Name="StartupAppsHost" Focusable="False" Margin="0,0,0,14" />

            <!-- Remote help -->
            <TextBlock x:Name="RemoteSection" Style="{StaticResource Shell.CardTitle}" Text="Remote help" Margin="2,0,0,8" />
            <Border Style="{StaticResource Shell.Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="RemoteGlyph" DockPanel.Dock="Left" Style="{StaticResource Shell.Glyph}" Text="&#xE8AF;" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock x:Name="RemoteState" Style="{StaticResource Shell.Body}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="RemoteDetail" Style="{StaticResource Shell.Secondary}" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ShareButton" Content="Let someone help me" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,8" Click="Share_Click"
                                AutomationProperties.HelpText="Opens RustDesk so you can share this PC's screen with someone you trust" />
                        <Button x:Name="ChooseRustDesk" Content="Choose RustDesk…" Margin="0,0,8,8" Click="ChooseRustDesk_Click" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Shell.Body}" Text="Help someone else" Margin="0,8,0,4" FontWeight="SemiBold" />
                    <!-- Wraps: on a narrow page Connect moves below the box instead of being cut off. -->
                    <WrapPanel>
                        <TextBox x:Name="PeerId" Width="240" Margin="0,0,8,8" AutomationProperties.Name="Their RustDesk ID" TextChanged="PeerId_TextChanged" />
                        <Button x:Name="ConnectButton" Content="Connect" IsEnabled="False" Margin="0,0,0,8" Click="Connect_Click"
                                AutomationProperties.HelpText="Opens RustDesk to connect to the ID you entered" />
                    </WrapPanel>
                    <TextBlock x:Name="PeerHint" Style="{StaticResource Shell.Secondary}" Margin="0,4,0,0" Text="Enter the ID shown in their RustDesk window." />
                    <Expander Header="Technical details" Margin="0,10,0,0" AutomationProperties.Name="Remote help technical details">
                        <TextBlock x:Name="RemoteTechnical" Style="{StaticResource Shell.Secondary}" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Defender scans -->
            <TextBlock x:Name="ScanSection" Style="{StaticResource Shell.CardTitle}" Text="Microsoft Defender" Margin="2,10,0,8" />
            <Border Style="{StaticResource Shell.Card}">
                <StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="QuickScan" Content="Quick scan" Margin="0,0,8,8" Click="QuickScan_Click" />
                        <Button x:Name="ScanFile" Content="Scan a file…" Margin="0,0,8,8" Click="ScanFile_Click" />
                        <Button x:Name="ScanFolder" Content="Scan a folder…" Margin="0,0,8,8" Click="ScanFolder_Click" />
                        <Button x:Name="UpdateIntelligence" Content="Update security intelligence" Margin="0,0,8,8" Click="UpdateIntelligence_Click" />
                        <Button x:Name="CancelScan" Content="Stop waiting" Margin="0,0,8,8" Visibility="Collapsed" Click="CancelScan_Click"
                                AutomationProperties.HelpText="Stops waiting for the result. A scan Windows already started may keep running." />
                    </WrapPanel>
                    <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="4" Margin="0,4,0,8" Visibility="Collapsed" AutomationProperties.Name="Scan in progress" />
                    <TextBlock x:Name="ScanResult" Style="{StaticResource Shell.Body}" AutomationProperties.LiveSetting="Polite" />
                    <Expander x:Name="EventsExpander" Header="Recent Microsoft Defender events" Margin="0,10,0,0" Expanded="EventsExpander_Expanded">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock x:Name="EventsHint" Style="{StaticResource Shell.Secondary}" />
                            <ItemsControl x:Name="EventsList" Focusable="False" AutomationProperties.Name="Recent Microsoft Defender events">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Shell.Secondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding What}" Style="{StaticResource Shell.Body}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Protected imports -->
            <TextBlock x:Name="ImportsSection" Style="{StaticResource Shell.CardTitle}" Text="Protected imports and quarantine" Margin="2,10,0,8" />
            <Border Style="{StaticResource Shell.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Text="Files in the protected imports folder are checked before you open them." />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="OpenImports" Content="Open protected imports folder" Margin="0,0,8,8" Click="OpenImports_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="QuarantineSummary" Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <ListBox x:Name="QuarantineList" MaxHeight="220" AutomationProperties.Name="Quarantined files" SelectionChanged="QuarantineList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Shell.Body}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Shell.Secondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel x:Name="QuarantineActions" Margin="0,8,0,0" Visibility="Collapsed">
                        <Button x:Name="RestoreButton" Content="Restore…" Margin="0,0,8,0" IsEnabled="False" Click="Restore_Click"
                                AutomationProperties.HelpText="Puts the selected file back where it came from" />
                        <Button x:Name="DeleteButton" Content="Delete permanently…" IsEnabled="False" Click="Delete_Click"
                                AutomationProperties.HelpText="Deletes the selected quarantined file; this cannot be undone" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
