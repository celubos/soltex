<UserControl x:Class="Soltex.App.Pages.SystemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Shell.Card}" AutomationProperties.Name="Full De-Windows">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="ReviewButton" DockPanel.Dock="Right" Content="Review…" VerticalAlignment="Center" Click="Review_Click"
                            AutomationProperties.Name="Review the full De-Windows changes" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Shell.CardTitle}" Text="Full De-Windows" />
                        <TextBlock x:Name="Summary" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" Text="Checking…" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="PlanPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <StackPanel x:Name="Areas" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="ApplyButton" Style="{StaticResource Studio.PrimaryButton}" Content="Apply" Margin="0,0,8,8" Click="Apply_Click"
                                AutomationProperties.HelpText="Windows asks for administrator permission once" />
                        <Button x:Name="UndoButton" Content="Undo system changes" Margin="0,0,8,8" Click="Undo_Click" />
                        <Button x:Name="CancelButton" Style="{StaticResource Studio.GhostButton}" Content="Close" Margin="0,0,8,8" Click="Cancel_Click" />
                    </WrapPanel>
                </StackPanel>
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.Name="Working" />
                <TextBlock x:Name="ResultText" Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Shell.Card}" AutomationProperties.Name="Windows Update">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource Studio.GhostButton}" Content="Check now" Margin="0,0,4,0" Click="CheckUpdates_Click" />
                    <Button Content="Windows Update" Click="OpenWindowsUpdate_Click" AutomationProperties.Name="Open Windows Update" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Shell.CardTitle}" Text="Windows Update" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
