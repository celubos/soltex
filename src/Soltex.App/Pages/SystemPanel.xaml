<UserControl x:Class="Soltex.App.Pages.SystemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audio="clr-namespace:Soltex.Audio.UI;assembly=Soltex.Audio.UI"
             xmlns:controls="clr-namespace:Soltex.App.Controls">
    <StackPanel>
        <Border Style="{StaticResource Shell.Card}" AutomationProperties.Name="Full De-Windows">
            <StackPanel>
                <!-- Same layout and wording as the De-Windows card: Undo… and Review… beside the summary, below it when narrow. -->
                <audio:ResponsiveRow MinPrimaryWidth="200" Spacing="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Shell.CardTitle}" Text="Full De-Windows" />
                        <TextBlock x:Name="Summary" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" Text="Checking…" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <Button x:Name="UndoButton" Content="Undo…" VerticalAlignment="Center" IsEnabled="False" Click="Undo_Click"
                            AutomationProperties.Name="Undo the full De-Windows changes"
                            AutomationProperties.HelpText="Puts back what Full De-Windows changed. Windows asks for administrator permission once; removed apps are not reinstalled." />
                    <Button x:Name="ReviewButton" Content="Review…" VerticalAlignment="Center" Click="Review_Click"
                            AutomationProperties.Name="Review the full De-Windows changes" />
                </audio:ResponsiveRow>
                <StackPanel x:Name="PlanPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <StackPanel x:Name="Areas" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="ApplyButton" Style="{StaticResource Studio.PrimaryButton}" Content="Apply" Margin="0,0,8,8" Click="Apply_Click"
                                AutomationProperties.HelpText="Windows asks for administrator permission once" />
                        <Button x:Name="CancelButton" Style="{StaticResource Studio.GhostButton}" Content="Close" Margin="0,0,8,8" Click="Cancel_Click" />
                    </WrapPanel>
                </StackPanel>
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.Name="Working" />
                <TextBlock x:Name="ResultText" Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                           controls:LiveRegion.IsLive="True" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Shell.Card}" AutomationProperties.Name="Windows Update">
            <!-- The buttons move below the text when the page is narrow. -->
            <audio:ResponsiveRow MinPrimaryWidth="200" Spacing="4">
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Shell.CardTitle}" Text="Windows Update" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" controls:LiveRegion.IsLive="True" />
                </StackPanel>
                <Button x:Name="CheckUpdatesButton" Style="{StaticResource Studio.GhostButton}" Content="Check now" VerticalAlignment="Center" Click="CheckUpdates_Click" />
                <Button Content="Windows Update" Click="OpenWindowsUpdate_Click" VerticalAlignment="Center" AutomationProperties.Name="Open Windows Update" />
            </audio:ResponsiveRow>
        </Border>
    </StackPanel>
</UserControl>
