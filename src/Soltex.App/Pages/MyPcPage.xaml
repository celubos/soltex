<UserControl x:Class="Soltex.App.Pages.MyPcPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Soltex.App.Controls"
             xmlns:pages="clr-namespace:Soltex.App.Pages">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Shell.Secondary}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Shell.Metric}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="{DynamicResource Shell.PagePadding}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="900" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Shell.PageTitle}" Text="Home" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource Shell.PageSubtitle}" />

            <pages:DeWindowsPanel x:Name="DeWindows" />
            <pages:SystemPanel x:Name="SystemPanel" />

            <!-- Protection -->
            <Border x:Name="ProtectionCard" Style="{StaticResource Shell.Card}" AutomationProperties.Name="Protection">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CheckAgain" Style="{StaticResource Studio.GhostButton}" Content="Check again" Margin="0,0,4,0" Click="CheckAgain_Click" />
                            <Button x:Name="UpdateDefinitions" Content="Update" Margin="0,0,8,0" Visibility="Collapsed" Click="UpdateDefinitions_Click"
                                    AutomationProperties.Name="Update security intelligence" />
                            <Button x:Name="OpenWindowsSecurity" Content="Windows Security" Click="OpenWindowsSecurity_Click" AutomationProperties.Name="Open Windows Security" />
                        </StackPanel>
                        <Border x:Name="ProtectionTile" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Margin="0,0,14,0"
                                Background="{DynamicResource Studio.HoverBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="ProtectionGlyph" Style="{StaticResource Shell.Glyph}" Text="&#xE83D;" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProtectionHeadline" Style="{StaticResource Shell.CardTitle}" Text="Checking protection…" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="ProtectionDetail" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl x:Name="ProtectionIssues" Margin="50,10,0,0" Focusable="False" AutomationProperties.Name="Protection issues">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,4" Style="{StaticResource Shell.Secondary}">
                                    <Run Text="{Binding Feature, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Effect, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PolicyNote" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="50,0,0,0" Visibility="Collapsed"
                               Text="Turned off by a policy on this PC." />
                    <Expander x:Name="ProtectionDetails" Header="Details" Margin="50,6,0,0" AutomationProperties.Name="Protection details">
                        <TextBlock x:Name="ProtectionTechnical" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Performance -->
            <Border x:Name="PerformanceCard" Style="{StaticResource Shell.Card}" AutomationProperties.Name="Performance">
                <StackPanel>
                    <UniformGrid x:Name="Metrics" Columns="4" Rows="1">
                        <StackPanel Margin="0,0,16,0" AutomationProperties.Name="Processor">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Processor" />
                            <TextBlock x:Name="CpuValue" Style="{StaticResource StatValue}" Text="–" />
                            <controls:Sparkline x:Name="CpuHistory" Height="28" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                Stroke="{DynamicResource AccentFillColorDefaultBrush}" GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                AutomationProperties.Name="Processor use over the last two minutes" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" AutomationProperties.Name="Memory">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Memory" />
                            <TextBlock x:Name="MemoryValue" Style="{StaticResource StatValue}" Text="–" />
                            <TextBlock x:Name="MemoryDetail" Style="{StaticResource StatLabel}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" AutomationProperties.Name="Storage">
                            <TextBlock x:Name="StorageLabel" Style="{StaticResource StatLabel}" Text="Storage" />
                            <TextBlock x:Name="StorageValue" Style="{StaticResource StatValue}" Text="–" />
                            <TextBlock x:Name="StorageDetail" Style="{StaticResource StatLabel}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel AutomationProperties.Name="Network">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Network" />
                            <TextBlock x:Name="NetworkValue" Style="{StaticResource StatValue}" Text="–" />
                            <TextBlock x:Name="NetworkDetail" Style="{StaticResource StatLabel}" Margin="0,6,0,0" />
                        </StackPanel>
                    </UniformGrid>
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock x:Name="PerformanceState" DockPanel.Dock="Right" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                        <Expander x:Name="ProcessesExpander" Header="Top apps" Expanded="ProcessesExpander_Changed" Collapsed="ProcessesExpander_Changed"
                                  AutomationProperties.Name="Apps using the most processor time">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock x:Name="ProcessesHint" Style="{StaticResource Shell.Secondary}" Text="Collecting…" />
                                <ItemsControl x:Name="ProcessList" Focusable="False" AutomationProperties.Name="Apps using the most processor time">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Shell.Body}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Cpu}" Style="{StaticResource Shell.Body}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Memory}" Style="{StaticResource Shell.Secondary}" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- This PC -->
            <Border x:Name="ThisPcCard" Style="{StaticResource Shell.Card}" AutomationProperties.Name="This PC">
                <Grid x:Name="FactsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition /></Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
