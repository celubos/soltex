<UserControl x:Class="Soltex.App.Pages.MicrophonePathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audio="clr-namespace:Soltex.Audio.UI;assembly=Soltex.Audio.UI"
             xmlns:controls="clr-namespace:Soltex.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14,16,16" />
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource Studio.CardBrush}" />
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource Studio.SelectedBrush}" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Studio.AccentTextBrush}" />
        </Style>
        <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource Studio.Eyebrow}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StepName" TargetType="TextBlock" BasedOn="{StaticResource Shell.Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Points to the next step inside each card. When the cards wrap, an arrow at the end of a row is hidden and a
             single column points down (MicrophonePathView.UpdateArrows), so no arrow points at nothing. -->
        <Style x:Key="Arrow" TargetType="TextBlock" BasedOn="{StaticResource Shell.Glyph}">
            <Setter Property="Text" Value="&#xE72A;" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Studio.AccentTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="AutomationProperties.Name" Value="leads to" />
        </Style>
        <DataTemplate x:Key="TrimmedLabel">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="TrimmedTitle">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- The Audio page is the scroll host and sets the content width. -->
    <StackPanel Margin="0,0,0,8">
        <audio:ResponsiveRow MinPrimaryWidth="220" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Shell.SectionTitle}" Margin="0" Text="My microphone" />
                <TextBlock x:Name="Explanation" Style="{StaticResource Shell.Secondary}" Margin="0,4,0,0" Text="Connecting to audio…" controls:LiveRegion.IsLive="True" />
            </StackPanel>
            <Border x:Name="StateBadge" CornerRadius="10" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <!-- No fixed accessible name: the text itself is the state, so screen readers hear "Stopped", "Running" and so on. -->
                <TextBlock x:Name="StateText" Style="{StaticResource Shell.Body}" FontWeight="SemiBold" TextWrapping="NoWrap" Text="Connecting…"
                           AutomationProperties.HelpText="Microphone state" controls:LiveRegion.IsLive="True" />
            </Border>
        </audio:ResponsiveRow>

        <!-- Microphone → processing → destination → the name other apps pick: four cards, then two by two, then one per row. -->
        <audio:AdaptiveGrid x:Name="Steps" MinColumnWidth="188" MaxColumns="4" ColumnSpacing="12" RowSpacing="12" Margin="0,0,0,16" AutomationProperties.Name="Microphone path"
                            SizeChanged="Steps_SizeChanged">
            <Border Style="{StaticResource Step}" AutomationProperties.Name="Source">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="SourceArrow" Style="{StaticResource Arrow}" />
                        <Border Style="{StaticResource StepNumber}"><TextBlock Style="{StaticResource StepNumberText}" Text="1" /></Border>
                        <TextBlock Style="{StaticResource StepLabel}" Text="Microphone" />
                    </DockPanel>
                    <TextBlock x:Name="SourceName" Style="{StaticResource StepName}" />
                    <TextBlock x:Name="SourceDetail" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,2,0,10" />
                    <audio:SignalMeter x:Name="InputMeter" Orientation="Horizontal" Thickness="6" Fill="{DynamicResource Studio.MeterHorizontalBrush}"
                                       Track="{DynamicResource Studio.TrackBrush}" AutomationProperties.Name="Microphone input level" />
                    <TextBlock x:Name="InputLevel" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Step}" AutomationProperties.Name="Processing">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="ProcessingArrow" Style="{StaticResource Arrow}" />
                        <Border Style="{StaticResource StepNumber}"><TextBlock Style="{StaticResource StepNumberText}" Text="2" /></Border>
                        <TextBlock Style="{StaticResource StepLabel}" Text="Processing" />
                    </DockPanel>
                    <!-- One text block (not an item list) so assistive technology reads every stage. -->
                    <TextBlock x:Name="ProcessingText" Style="{StaticResource Shell.Body}" LineHeight="21" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Step}" AutomationProperties.Name="Sends to">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="DestinationArrow" Style="{StaticResource Arrow}" />
                        <Border Style="{StaticResource StepNumber}"><TextBlock Style="{StaticResource StepNumberText}" Text="3" /></Border>
                        <TextBlock Style="{StaticResource StepLabel}" Text="Sends to" />
                    </DockPanel>
                    <TextBlock x:Name="DestinationName" Style="{StaticResource StepName}" Margin="0,0,0,10" />
                    <audio:SignalMeter x:Name="OutputMeter" Orientation="Horizontal" Thickness="6" Fill="{DynamicResource Studio.MeterHorizontalBrush}"
                                       Track="{DynamicResource Studio.TrackBrush}" AutomationProperties.Name="Processed output level" />
                    <TextBlock x:Name="OutputLevel" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="ReceivingStep" Style="{StaticResource Step}" AutomationProperties.Name="Apps choose">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Style="{StaticResource StepNumberText}" Text="4" /></Border>
                        <TextBlock Style="{StaticResource StepLabel}" Text="In other apps, choose" />
                    </DockPanel>
                    <TextBlock x:Name="ReceivingName" Style="{StaticResource StepName}" FontSize="15" />
                    <TextBlock x:Name="ReceivingDetail" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,2,0,10" />
                    <Button x:Name="CopyName" Content="Copy name" HorizontalAlignment="Left" Click="CopyName_Click"
                            AutomationProperties.Name="Copy the microphone name other apps use" />
                </StackPanel>
            </Border>
        </audio:AdaptiveGrid>

        <WrapPanel Margin="0,0,0,8">
            <Button x:Name="TestButton" Style="{DynamicResource AccentButtonStyle}" Content="Test my microphone" Margin="0,0,8,8" MinWidth="160"
                    Click="TestButton_Click" />
            <Button x:Name="StartStopButton" Content="Start audio" Margin="0,0,8,8" Click="StartStopButton_Click" />
            <Button x:Name="ChangeButton" Content="Change setup" Margin="0,0,8,8" Click="ChangeButton_Click" />
            <Button x:Name="SoundButton" Content="Adjust sound…" Margin="0,0,8,8" Click="SoundButton_Click"
                    AutomationProperties.Name="Adjust the microphone's sound processing" />
        </WrapPanel>

        <Border x:Name="TestPanel" Style="{StaticResource Shell.InfoBar}" Tag="Information" Visibility="Collapsed"
                AutomationProperties.Name="Microphone test">
            <StackPanel>
                <!-- Polite: the verdict is announced once. The countdown beside it changes every second, so it is not a live
                     region at all (a screen reader would otherwise be interrupted each second). -->
                <DockPanel>
                    <TextBlock x:Name="TestCountdown" DockPanel.Dock="Right" Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Margin="8,0,0,0"
                               Visibility="Collapsed" AutomationProperties.HelpText="Seconds left in the test" />
                    <TextBlock x:Name="TestTitle" Style="{StaticResource Shell.Body}" FontWeight="SemiBold" controls:LiveRegion.IsLive="True" />
                </DockPanel>
                <TextBlock x:Name="TestAdvice" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" controls:LiveRegion.IsLive="True" />
                <Button x:Name="FixButton" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" Click="FixButton_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="SetupPanel" Style="{StaticResource Shell.Card}" Visibility="Collapsed" Margin="0,8,0,0"
                AutomationProperties.Name="Microphone setup">
            <StackPanel MaxWidth="660" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource Shell.CardTitle}" Text="Set up my microphone" />
                <TextBlock Style="{StaticResource Shell.Secondary}" Margin="0,4,0,14"
                           Text="Nothing changes until you choose Save, and saving never starts audio by itself. If audio is already on, the new setup is used at once." />

                <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Text="Microphone" />
                <ComboBox x:Name="MicrophoneChoice" ItemTemplate="{StaticResource TrimmedLabel}" Margin="0,6,0,4" AutomationProperties.Name="Microphone"
                          ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" />
                <TextBlock Style="{StaticResource Shell.Secondary}" FontSize="12"
                           Text="For an audio interface, choose its input, not its speakers or headphones." />

                <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Margin="0,16,0,0" Text="Which input is the microphone plugged into?" />
                <ComboBox x:Name="InputChoice" ItemTemplate="{StaticResource TrimmedLabel}" Margin="0,6,0,4" AutomationProperties.Name="Microphone input"
                          ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" />
                <TextBlock Style="{StaticResource Shell.Secondary}" FontSize="12"
                           Text="Not sure? Save, then choose Test my microphone. It tells you which input your voice arrives on." />

                <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Margin="0,16,0,0" Text="Send my voice to" />
                <ComboBox x:Name="DestinationChoice" ItemTemplate="{StaticResource TrimmedLabel}" Margin="0,6,0,4" AutomationProperties.Name="Send my voice to"
                          SelectionChanged="DestinationChoice_SelectionChanged" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="DestinationHint" Style="{StaticResource Shell.Secondary}" FontSize="12" />

                <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Margin="0,16,0,0" Text="Sound" />
                <ComboBox x:Name="SoundChoice" ItemTemplate="{StaticResource TrimmedTitle}" Margin="0,6,0,4" AutomationProperties.Name="Sound"
                          SelectionChanged="SoundChoice_SelectionChanged" ToolTip="{Binding SelectedItem.Title, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="SoundHint" Style="{StaticResource Shell.Secondary}" FontSize="12" />

                <Border x:Name="SetupError" Style="{StaticResource Shell.InfoBar}" Tag="Critical" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock x:Name="SetupErrorText" Style="{StaticResource Shell.Body}" controls:LiveRegion.IsLive="True" AutomationProperties.LiveSetting="Assertive" />
                </Border>
                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="SaveSetup" Style="{DynamicResource AccentButtonStyle}" Content="Save" MinWidth="110" Margin="0,0,8,8" Click="SaveSetup_Click"
                            AutomationProperties.Name="Save microphone setup" />
                    <Button x:Name="CancelSetup" Content="Cancel" MinWidth="110" Margin="0,0,8,8" Click="CancelSetup_Click" AutomationProperties.Name="Cancel microphone setup" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
