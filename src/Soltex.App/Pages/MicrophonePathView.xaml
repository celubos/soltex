<UserControl x:Class="Soltex.App.Pages.MicrophonePathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Width" Value="196" />
            <Setter Property="MinHeight" Value="140" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource Studio.CardBrush}" />
        </Style>
        <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource Studio.Eyebrow}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="StepName" TargetType="TextBlock" BasedOn="{StaticResource Shell.Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Arrow" TargetType="TextBlock" BasedOn="{StaticResource Shell.Glyph}">
            <Setter Property="Text" Value="&#xE72A;" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="6,0,6,10" />
            <Setter Property="Foreground" Value="{DynamicResource Studio.AccentTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AutomationProperties.Name" Value="leads to" />
        </Style>
    </UserControl.Resources>

    <!-- The Audio page is the scroll host and sets the content width. -->
    <StackPanel Margin="0,0,0,8">
        <DockPanel Margin="0,0,0,4">
            <Border x:Name="StateBadge" DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <!-- No fixed accessible name: the text itself is the state, so screen readers hear "Stopped", "On" and so on. -->
                <TextBlock x:Name="StateText" Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Text="Connecting…"
                           AutomationProperties.HelpText="Microphone state" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <TextBlock Style="{StaticResource Shell.SectionTitle}" Margin="0" Text="My microphone" />
        </DockPanel>
        <TextBlock x:Name="Explanation" Style="{StaticResource Shell.Secondary}" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="Connecting to audio…" AutomationProperties.LiveSetting="Polite" />

        <WrapPanel x:Name="Steps" AutomationProperties.Name="Microphone path">
            <Border Style="{StaticResource Step}" AutomationProperties.Name="Source">
                <StackPanel>
                    <TextBlock Style="{StaticResource StepLabel}" Text="1 · Microphone" />
                    <TextBlock x:Name="SourceName" Style="{StaticResource StepName}" />
                    <TextBlock x:Name="SourceDetail" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap" />
                    <ProgressBar x:Name="InputMeter" Height="6" Minimum="0" Maximum="1" AutomationProperties.Name="Microphone input level" />
                    <TextBlock x:Name="InputLevel" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Arrow}" />
            <Border Style="{StaticResource Step}" AutomationProperties.Name="Processing">
                <StackPanel>
                    <TextBlock Style="{StaticResource StepLabel}" Text="2 · Processing" />
                    <!-- One text block (not an item list) so assistive technology reads every stage. -->
                    <TextBlock x:Name="ProcessingText" Style="{StaticResource Shell.Body}" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Arrow}" />
            <Border Style="{StaticResource Step}" AutomationProperties.Name="Sends to">
                <StackPanel>
                    <TextBlock Style="{StaticResource StepLabel}" Text="3 · Sends to" />
                    <TextBlock x:Name="DestinationName" Style="{StaticResource StepName}" Margin="0,0,0,8" />
                    <ProgressBar x:Name="OutputMeter" Height="6" Minimum="0" Maximum="1" AutomationProperties.Name="Processed output level" />
                    <TextBlock x:Name="OutputLevel" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Arrow}" />
            <Border x:Name="ReceivingStep" Style="{StaticResource Step}" AutomationProperties.Name="Apps choose">
                <StackPanel>
                    <TextBlock Style="{StaticResource StepLabel}" Text="4 · In other apps, choose" />
                    <TextBlock x:Name="ReceivingName" Style="{StaticResource StepName}" FontSize="15" />
                    <TextBlock x:Name="ReceivingDetail" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap" />
                    <Button x:Name="CopyName" Content="Copy name" HorizontalAlignment="Left" Click="CopyName_Click"
                            AutomationProperties.Name="Copy the microphone name other apps use" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <WrapPanel Margin="0,6,0,12">
            <Button x:Name="TestButton" Style="{DynamicResource AccentButtonStyle}" Content="Test my microphone" Margin="0,0,8,8" MinWidth="160"
                    Click="TestButton_Click" />
            <Button x:Name="StartStopButton" Content="Start audio" Margin="0,0,8,8" Click="StartStopButton_Click" />
            <Button x:Name="ChangeButton" Content="Change setup" Margin="0,0,8,8" Click="ChangeButton_Click" />
            <Button x:Name="SoundButton" Content="Adjust sound…" Margin="0,0,8,8" Click="SoundButton_Click"
                    AutomationProperties.Name="Adjust the microphone's sound processing" />
        </WrapPanel>

        <Border x:Name="TestPanel" Style="{StaticResource Shell.InfoBar}" Tag="Information" Visibility="Collapsed"
                AutomationProperties.Name="Microphone test">
            <StackPanel>
                <TextBlock x:Name="TestTitle" Style="{StaticResource Shell.Body}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive" />
                <TextBlock x:Name="TestAdvice" Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="FixButton" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" Click="FixButton_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="SetupPanel" Style="{StaticResource Shell.Card}" Visibility="Collapsed" Margin="0,12,0,0"
                AutomationProperties.Name="Microphone setup">
            <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Shell.CardTitle}" Text="Set up my microphone" />
                <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Nothing changes until you choose Save, and saving never starts audio by itself. If audio is already on, the new setup is used at once." />

                <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Text="Microphone" />
                <ComboBox x:Name="MicrophoneChoice" DisplayMemberPath="Label" Margin="0,4,0,2" AutomationProperties.Name="Microphone" />
                <TextBlock Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap"
                           Text="For an audio interface, choose its input, not its speakers or headphones." />

                <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Margin="0,14,0,0" Text="Which input is the microphone plugged into?" />
                <ComboBox x:Name="InputChoice" DisplayMemberPath="Label" Margin="0,4,0,2" AutomationProperties.Name="Microphone input" />
                <TextBlock Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap"
                           Text="Not sure? Save, then choose Test my microphone. It tells you which input your voice arrives on." />

                <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Margin="0,14,0,0" Text="Send my voice to" />
                <ComboBox x:Name="DestinationChoice" DisplayMemberPath="Label" Margin="0,4,0,2" AutomationProperties.Name="Send my voice to"
                          SelectionChanged="DestinationChoice_SelectionChanged" />
                <TextBlock x:Name="DestinationHint" Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource Shell.Body}" FontWeight="SemiBold" Margin="0,14,0,0" Text="Sound" />
                <ComboBox x:Name="SoundChoice" DisplayMemberPath="Title" Margin="0,4,0,2" AutomationProperties.Name="Sound"
                          SelectionChanged="SoundChoice_SelectionChanged" />
                <TextBlock x:Name="SoundHint" Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap" />

                <Border x:Name="SetupError" Style="{StaticResource Shell.InfoBar}" Tag="Critical" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="SetupErrorText" Style="{StaticResource Shell.Body}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </Border>
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="SaveSetup" Style="{DynamicResource AccentButtonStyle}" Content="Save" MinWidth="110" Margin="0,0,8,0" Click="SaveSetup_Click"
                            AutomationProperties.Name="Save microphone setup" />
                    <Button x:Name="CancelSetup" Content="Cancel" MinWidth="110" Click="CancelSetup_Click" AutomationProperties.Name="Cancel microphone setup" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
