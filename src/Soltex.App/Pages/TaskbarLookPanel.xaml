<UserControl x:Class="Soltex.App.Pages.TaskbarLookPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Studio.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="15" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Padding="3" Background="Transparent">
                            <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{DynamicResource Studio.StrokeStrongBrush}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Studio.Row}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Shell.Body}" Text="Background" />
                    <TextBlock x:Name="Note" Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ComboBox x:Name="LookList" Grid.Column="1" MinWidth="220" Margin="16,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Taskbar background" SelectionChanged="Look_Changed" />
            </Grid>
        </Border>

        <Border x:Name="ColorRow" Style="{StaticResource Studio.Row}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Shell.Body}" Text="Color" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" />
                    <Button x:Name="CustomButton" Style="{StaticResource Studio.GhostButton}" Content="Custom" Margin="6,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Choose a custom taskbar color" Click="Custom_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="OpacityRow" Style="{StaticResource Studio.Row}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="OpacityLabel" Style="{StaticResource Shell.Body}" Text="Tint" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Slider x:Name="OpacitySlider" Width="200" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True"
                            TickFrequency="5" VerticalAlignment="Center" AutomationProperties.Name="Taskbar tint" ValueChanged="Opacity_Changed" />
                    <TextBlock x:Name="OpacityText" Style="{StaticResource Shell.Secondary}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="MaximizedRow" Style="{StaticResource Studio.Row}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Shell.Body}" Text="When a window is maximized" VerticalAlignment="Center" />
                <ComboBox x:Name="MaximizedList" Grid.Column="1" MinWidth="220" Margin="16,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Taskbar background when a window is maximized" SelectionChanged="Maximized_Changed" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Studio.Row}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Shell.Body}" Text="Line above the taskbar" VerticalAlignment="Center" />
                <CheckBox x:Name="LineSwitch" Grid.Column="1" Style="{StaticResource Studio.Switch}" Margin="16,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Line above the taskbar" Checked="Line_Changed" Unchecked="Line_Changed" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
