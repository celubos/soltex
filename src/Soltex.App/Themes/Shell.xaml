<!--
    Shell styles. Colours resolve through the shared Fluent keys, which the Studio palette re-points;
    in high contrast the same keys fall back to Windows' own colours. No colour literals here.
    Layout tokens (padding, gaps, nav height) are set by ThemeService from the user's density preference.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Shell.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Thickness x:Key="Shell.PagePadding">36,24,36,32</Thickness>
    <Thickness x:Key="Shell.CardPadding">20,16,20,18</Thickness>
    <Thickness x:Key="Shell.CardGap">0,0,0,14</Thickness>
    <Thickness x:Key="Shell.RowGap">0,7,0,7</Thickness>
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="Shell.NavItemHeight">40</system:Double>
    <!-- Navigation item spacing. The shell window shadows these (and the height) on its lists when the window is short,
         and moves items clear of the list's scroll bar when the list has to scroll. -->
    <Thickness x:Key="Shell.NavItemMargin">6,2</Thickness>
    <Thickness x:Key="Shell.NavItemCompactMargin">2,2</Thickness>
    <!-- The widest page content column. The shell stretches every page to the window edge (scroll bar at the edge) and
         every page caps its content column at this width, so columns line up from page to page: pages bind their frame
         column to it (MaxWidth="{DynamicResource Shell.PageMaxWidth}"). 1040 leaves Audio's channel strips their room. -->
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="Shell.PageMaxWidth">1040</system:Double>
    <!-- Studio controls' animation length. ThemeService sets it to zero when the user or Windows turns animations off. -->
    <Duration x:Key="Studio.MotionDuration">0:0:0.12</Duration>

    <Style x:Key="Shell.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="{DynamicResource Shell.CardPadding}" />
        <Setter Property="Margin" Value="{DynamicResource Shell.CardGap}" />
    </Style>

    <Style x:Key="Shell.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Shell.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Shell.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Shell.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Shell.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Shell.Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Shell.Metric" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Shell.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Shell.IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Navigation item: selection pill + hover fill + visible focus ring. Selected text, icon and pill use the
         Studio.Selected* brushes, which high contrast maps to HighlightText on the Highlight fill. -->
    <Style x:Key="Shell.NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{DynamicResource Shell.NavItemHeight}" />
        <Setter Property="Margin" Value="{DynamicResource Shell.NavItemMargin}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
        <Setter Property="ToolTip" Value="{Binding Description}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="10" Background="Transparent" />
                        <Border x:Name="Pill" Width="4" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource Studio.SelectedPillBrush}" Visibility="Collapsed" />
                        <Border x:Name="Focus" CornerRadius="10" BorderThickness="2" Visibility="Collapsed"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Studio.SelectedBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Studio.SelectedTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The icon follows the item's foreground (the glyph style alone would keep primary text, unreadable on a high
         contrast selection); the label inherits it. -->
    <DataTemplate x:Key="Shell.NavItemTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Shell.Glyph}" Text="{Binding Glyph}" FontSize="16" Margin="2,0,14,0"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Icon-only navigation item for the narrow rail: same selection pill, hover fill and focus ring; the label moves
         into the tooltip, and the accessible name stays the label. -->
    <Style x:Key="Shell.NavItemCompact" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{DynamicResource Shell.NavItemHeight}" />
        <Setter Property="Margin" Value="{DynamicResource Shell.NavItemCompactMargin}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
        <Setter Property="ToolTip" Value="{Binding CompactTip}" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="10" Background="Transparent" />
                        <Border x:Name="Pill" Width="4" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource Studio.SelectedPillBrush}" Visibility="Collapsed" />
                        <Border x:Name="Focus" CornerRadius="10" BorderThickness="2" Visibility="Collapsed"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Studio.SelectedBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Studio.SelectedTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Shell.NavItemCompactTemplate">
        <TextBlock Style="{StaticResource Shell.Glyph}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
    </DataTemplate>

    <!-- The line between the page list and History/Settings. -->
    <Style x:Key="Shell.RailRule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="14,6" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Search result: the rail's selection look (violet tint, pill, HighlightText in high contrast). The right margin
         keeps a lane for the list's scroll bar, which is drawn over the list's edge, so it never covers the highlight. -->
    <Style x:Key="Shell.SearchResultItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,1,16,1" />
        <Setter Property="Padding" Value="14,6,10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Location}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Margin="3,0,0,0"
                                Background="{DynamicResource Studio.SelectedPillBrush}" Visibility="Collapsed" />
                        <Border x:Name="Focus" CornerRadius="8" BorderThickness="2" Visibility="Collapsed"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Studio.SelectedBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Studio.SelectedTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Shell.SearchResultTemplate">
        <StackPanel Margin="0,1">
            <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock x:Name="Where" Text="{Binding Location}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Where" Property="Foreground" Value="{DynamicResource Studio.SelectedSecondaryTextBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Severity-coloured message bar. Tag carries the severity name: Information, Success, Caution, Critical. -->
    <Style x:Key="Shell.InfoBar" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Success">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Caution">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A settings row: label + description on the left, control on the right. -->
    <Style x:Key="Shell.SettingRow" TargetType="Grid">
        <Setter Property="Margin" Value="{DynamicResource Shell.RowGap}" />
    </Style>

    <Style x:Key="Shell.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>
</ResourceDictionary>
