<!--
    Studio controls. Theme-agnostic: every brush is a DynamicResource from Studio.Dark/Light.xaml,
    so switching light/dark restyles these live. No colour literals.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Studio.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Studio.TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Focus ring shared by every Studio control: visible, accent-coloured, never clipped. -->
    <Style x:Key="Studio.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Studio.AccentTextBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action: violet gradient pill. Also replaces Fluent's AccentButtonStyle everywhere. -->
    <Style x:Key="Studio.PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Studio.OnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource Studio.AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Studio.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="10" Background="{TemplateBinding Background}" />
                        <Border x:Name="Sheen" CornerRadius="10" Background="{DynamicResource Studio.HoverBrush}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Sheen" Property="Opacity" Value="1" />
                            <Setter TargetName="Fill" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource Studio.PrimaryButton}" />

    <!-- Secondary action: quiet filled pill with a hairline. -->
    <Style x:Key="Studio.SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Studio.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Studio.ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Studio.StrokeStrongBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Studio.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <Border x:Name="Hover" CornerRadius="10" Background="{DynamicResource Studio.HoverBrush}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Studio.AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost: text-only action for low-emphasis commands. -->
    <Style x:Key="Studio.GhostButton" TargetType="Button" BasedOn="{StaticResource Studio.SecondaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.AccentTextBrush}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- Every plain Button in the suite gets the secondary look (Fluent's default stays for controls inside templates). -->
    <Style TargetType="Button" BasedOn="{StaticResource Studio.SecondaryButton}" />

    <!-- Plain check boxes keep a square box: the palette's larger ControlCornerRadius would draw them almost round,
         like radio buttons. -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Style.Resources>
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        </Style.Resources>
        <Setter Property="Border.CornerRadius" Value="4" />
    </Style>

    <!-- Toggle switch on a CheckBox, so UI Automation still sees a Toggle pattern and IsChecked bindings keep working. -->
    <Style x:Key="Studio.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Studio.TextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="SwitchBox" Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource Studio.SwitchOffBrush}"
                                    BorderBrush="{DynamicResource Studio.StrokeStrongBrush}" BorderThickness="1" />
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" Margin="3,0,0,0"
                                    Background="{DynamicResource Studio.TextSecondaryBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="15" BorderThickness="2" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource Studio.AccentTextBrush}" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Studio.AccentGradientBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Studio.OnAccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="20" Duration="{StaticResource Studio.MotionDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="{StaticResource Studio.MotionDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Studio.AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Off and unavailable: the whole switch fades. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SwitchBox" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <!-- On but unavailable: still reads as on (muted violet track, solid light knob), never as a
                             faded violet track with a grey knob. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchBox" Property="Opacity" Value="1" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Studio.SwitchOnDisabledBrush}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Studio.SwitchKnobOnDisabledBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical channel fader. Foreground carries the channel colour. -->
    <Style x:Key="Studio.FaderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Width="8" CornerRadius="4" HorizontalAlignment="Center"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Studio.FaderGap" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Studio.Fader" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Width="48" Background="Transparent">
                        <Border Width="8" CornerRadius="4" HorizontalAlignment="Center" Margin="0,11" Background="{DynamicResource Studio.TrackBrush}" />
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Studio.FaderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Studio.FaderGap}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="42" Height="22" CornerRadius="7" Background="{DynamicResource Studio.FaderCapBrush}"
                                                    BorderBrush="{DynamicResource Studio.StrokeStrongBrush}" BorderThickness="1">
                                                <Border Height="3" Margin="9,0" CornerRadius="1.5" VerticalAlignment="Center"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" Visibility="Collapsed" BorderBrush="{DynamicResource Studio.AccentTextBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill toggle (Mute and similar). A CheckBox, so it keeps the Toggle pattern; checked = critical tint. -->
    <Style x:Key="Studio.TogglePill" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Studio.TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="9" Background="{DynamicResource Studio.ControlBrush}" BorderBrush="{DynamicResource Studio.StrokeStrongBrush}" BorderThickness="1" />
                        <Border x:Name="Ring" Margin="-3" CornerRadius="12" BorderThickness="2" Visibility="Collapsed" BorderBrush="{DynamicResource Studio.AccentTextBrush}" />
                        <ContentPresenter Margin="12,6" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Studio.AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Studio.CriticalSurfaceBrush}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Studio.CriticalBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Studio.CriticalBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact combo for dense surfaces (mixer strips). -->
    <Style x:Key="Studio.CompactCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,4,6,4" />
    </Style>

    <!-- Segmented tabs (ListBoxItem): filled pill when selected, quiet text otherwise. -->
    <Style x:Key="Studio.SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
                        <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" Visibility="Collapsed" BorderBrush="{DynamicResource Studio.AccentTextBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Studio.HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Studio.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Studio.RaisedBrush}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Studio.StrokeStrongBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Studio.TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A setting row: label on the left, control on the right (Windows Settings card layout). -->
    <Style x:Key="Studio.Row" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="62" />
    </Style>

    <!-- Small rounded label: device names, states, counts. -->
    <Style x:Key="Studio.Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource Studio.HoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Studio.StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Big hero surface with the signature glow along its top edge. -->
    <Style x:Key="Studio.Hero" TargetType="Border">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="28,24" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Background" Value="{DynamicResource Studio.CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Studio.StrokeStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Small caption above a group. Tertiary text is at least 4.5:1 on every Studio surface (see Tokens.xaml). -->
    <Style x:Key="Studio.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.TextTertiaryBrush}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>
</ResourceDictionary>
