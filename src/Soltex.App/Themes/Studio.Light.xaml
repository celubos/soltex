<!--
    Studio light theme. No colour literals: every colour comes from Tokens.xaml.
    Merged after the Fluent theme, so the shared Fluent keys below re-point every standard control
    at the Studio palette, and the Studio.* brushes serve the suite's own controls.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Studio surfaces and text -->
    <SolidColorBrush x:Key="Studio.BaseBrush" Color="{StaticResource StudioLightBase}" />
    <SolidColorBrush x:Key="Studio.RailBrush" Color="{StaticResource StudioLightRail}" />
    <SolidColorBrush x:Key="Studio.RaisedBrush" Color="{StaticResource StudioLightRaised}" />
    <SolidColorBrush x:Key="Studio.ControlBrush" Color="{StaticResource StudioLightControl}" />
    <SolidColorBrush x:Key="Studio.TrackBrush" Color="{StaticResource StudioLightTrack}" />
    <SolidColorBrush x:Key="Studio.StrokeBrush" Color="{StaticResource StudioLightStroke}" />
    <SolidColorBrush x:Key="Studio.StrokeStrongBrush" Color="{StaticResource StudioLightStrokeStrong}" />
    <SolidColorBrush x:Key="Studio.TextBrush" Color="{StaticResource StudioLightText}" />
    <SolidColorBrush x:Key="Studio.TextSecondaryBrush" Color="{StaticResource StudioLightTextSecondary}" />
    <SolidColorBrush x:Key="Studio.TextTertiaryBrush" Color="{StaticResource StudioLightTextTertiary}" />
    <SolidColorBrush x:Key="Studio.HoverBrush" Color="{StaticResource StudioLightHover}" />
    <SolidColorBrush x:Key="Studio.SelectedBrush" Color="{StaticResource StudioLightSelected}" />
    <!-- Text, secondary text and the pill on a selected row (high contrast swaps them for HighlightText). -->
    <SolidColorBrush x:Key="Studio.SelectedTextBrush" Color="{StaticResource StudioLightText}" />
    <SolidColorBrush x:Key="Studio.SelectedSecondaryTextBrush" Color="{StaticResource StudioLightTextSecondary}" />
    <SolidColorBrush x:Key="Studio.SelectedPillBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="Studio.SwitchOnDisabledBrush" Color="{StaticResource StudioLightSwitchOnDisabled}" />
    <SolidColorBrush x:Key="Studio.SwitchKnobOnDisabledBrush" Color="{StaticResource StudioOnAccent}" />
    <SolidColorBrush x:Key="Studio.AccentBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="Studio.AccentTextBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="Studio.CyanBrush" Color="{StaticResource StudioAccentCyanDeep}" />
    <SolidColorBrush x:Key="Studio.OnAccentBrush" Color="{StaticResource StudioOnAccent}" />
    <SolidColorBrush x:Key="Studio.SuccessBrush" Color="{StaticResource StudioSuccessDeep}" />
    <SolidColorBrush x:Key="Studio.CautionBrush" Color="{StaticResource StudioCautionDeep}" />
    <SolidColorBrush x:Key="Studio.CriticalBrush" Color="{StaticResource StudioCriticalDeep}" />
    <SolidColorBrush x:Key="Studio.SuccessSurfaceBrush" Color="{StaticResource StudioLightSuccessSurface}" />
    <SolidColorBrush x:Key="Studio.CautionSurfaceBrush" Color="{StaticResource StudioLightCautionSurface}" />
    <SolidColorBrush x:Key="Studio.CriticalSurfaceBrush" Color="{StaticResource StudioLightCriticalSurface}" />
    <SolidColorBrush x:Key="Studio.InfoSurfaceBrush" Color="{StaticResource StudioLightInfoSurface}" />
    <SolidColorBrush x:Key="Studio.FaderCapBrush" Color="{StaticResource StudioLightRaised}" />
    <SolidColorBrush x:Key="Studio.SwitchOffBrush" Color="{StaticResource StudioLightTrack}" />
    <!-- Deep variants: channel names are text, so they need 4.5:1 on white. -->
    <SolidColorBrush x:Key="Studio.Channel.Microphone" Color="{StaticResource StudioChannelMicDeep}" />
    <SolidColorBrush x:Key="Studio.Channel.Game" Color="{StaticResource StudioChannelGameDeep}" />
    <SolidColorBrush x:Key="Studio.Channel.Chat" Color="{StaticResource StudioChannelChatDeep}" />
    <SolidColorBrush x:Key="Studio.Channel.Media" Color="{StaticResource StudioChannelMediaDeep}" />
    <SolidColorBrush x:Key="Studio.Channel.Aux" Color="{StaticResource StudioChannelAuxDeep}" />
    <SolidColorBrush x:Key="Studio.Channel.Master" Color="{StaticResource StudioLightText}" />

    <LinearGradientBrush x:Key="Studio.CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource StudioLightCardTop}" Offset="0" />
        <GradientStop Color="{StaticResource StudioLightCard}" Offset="1" />
    </LinearGradientBrush>
    <!-- Buttons and filled controls: violet range only, so white text keeps its contrast. -->
    <LinearGradientBrush x:Key="Studio.AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource StudioAccentDeep}" Offset="0" />
        <GradientStop Color="{StaticResource StudioAccentDeep}" Offset="1" />
    </LinearGradientBrush>
    <!-- Decorative only (rules, rings, meters): violet to cyan. -->
    <LinearGradientBrush x:Key="Studio.SignatureBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource StudioAccentDeep}" Offset="0" />
        <GradientStop Color="{StaticResource StudioAccentCyanDeep}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Studio.MeterBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="{StaticResource StudioSuccessDeep}" Offset="0" />
        <GradientStop Color="{StaticResource StudioSuccessDeep}" Offset="0.62" />
        <GradientStop Color="{StaticResource StudioCautionDeep}" Offset="0.84" />
        <GradientStop Color="{StaticResource StudioCriticalDeep}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Studio.MeterHorizontalBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource StudioSuccessDeep}" Offset="0" />
        <GradientStop Color="{StaticResource StudioSuccessDeep}" Offset="0.62" />
        <GradientStop Color="{StaticResource StudioCautionDeep}" Offset="0.84" />
        <GradientStop Color="{StaticResource StudioCriticalDeep}" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Studio.GlowVioletBrush" Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="{StaticResource StudioLightGlowViolet}" Offset="0" />
        <GradientStop Color="Transparent" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Studio.GlowCyanBrush" Center="1,1" GradientOrigin="1,1" RadiusX="0.7" RadiusY="0.8">
        <GradientStop Color="{StaticResource StudioLightGlowCyan}" Offset="0" />
        <GradientStop Color="Transparent" Offset="1" />
    </RadialGradientBrush>

    <!-- Shared Fluent keys re-pointed at the Studio palette (every standard control follows). -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource StudioLightBase}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource StudioLightRail}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource StudioLightCard}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource StudioLightStroke}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource StudioLightText}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource StudioLightTextSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource StudioLightTextTertiary}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource StudioLightHover}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource StudioLightStroke}" />
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="{StaticResource StudioLightSmoke}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource StudioOnAccent}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{StaticResource StudioLightSuccessSurface}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{StaticResource StudioLightCautionSurface}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{StaticResource StudioLightCriticalSurface}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{StaticResource StudioLightInfoSurface}" />

    <!-- Fluent controls that otherwise take Windows' accent colour (grey or any colour the user picked): check boxes,
         radio buttons, slider thumbs, progress bars, list selection, focused fields and links use the Studio violet.
         High contrast does not load this file, so Windows' contrast colours stay. -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="{StaticResource StudioOnAccent}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="{StaticResource StudioOnAccentPressed}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPointerOver" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPressed" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedStrokePressed" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{StaticResource StudioOnAccent}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{StaticResource StudioLightSelectedStrong}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="{StaticResource StudioLightSelectedStrongHover}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="{StaticResource StudioLightSelectedStrongHover}" />
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressedThemeBrush" Color="{StaticResource StudioLightSelectedStrongHover}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{StaticResource StudioLightText}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="HyperlinkForeground" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{StaticResource StudioAccent}" />
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
</ResourceDictionary>
