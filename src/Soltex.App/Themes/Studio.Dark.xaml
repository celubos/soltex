<!--
    Studio dark theme. No colour literals: every colour comes from Tokens.xaml.
    Merged after the Fluent theme, so the shared Fluent keys below re-point every standard control
    at the Studio palette, and the Studio.* brushes serve the suite's own controls.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Studio surfaces and text -->
    <SolidColorBrush x:Key="Studio.BaseBrush" Color="{StaticResource StudioDarkBase}" />
    <SolidColorBrush x:Key="Studio.RailBrush" Color="{StaticResource StudioDarkRail}" />
    <SolidColorBrush x:Key="Studio.RaisedBrush" Color="{StaticResource StudioDarkRaised}" />
    <SolidColorBrush x:Key="Studio.ControlBrush" Color="{StaticResource StudioDarkControl}" />
    <SolidColorBrush x:Key="Studio.TrackBrush" Color="{StaticResource StudioDarkTrack}" />
    <SolidColorBrush x:Key="Studio.StrokeBrush" Color="{StaticResource StudioDarkStroke}" />
    <SolidColorBrush x:Key="Studio.StrokeStrongBrush" Color="{StaticResource StudioDarkStrokeStrong}" />
    <SolidColorBrush x:Key="Studio.TextBrush" Color="{StaticResource StudioDarkText}" />
    <SolidColorBrush x:Key="Studio.TextSecondaryBrush" Color="{StaticResource StudioDarkTextSecondary}" />
    <SolidColorBrush x:Key="Studio.TextTertiaryBrush" Color="{StaticResource StudioDarkTextTertiary}" />
    <SolidColorBrush x:Key="Studio.HoverBrush" Color="{StaticResource StudioDarkHover}" />
    <SolidColorBrush x:Key="Studio.SelectedBrush" Color="{StaticResource StudioDarkSelected}" />
    <SolidColorBrush x:Key="Studio.AccentBrush" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="Studio.AccentTextBrush" Color="{StaticResource StudioAccentBright}" />
    <SolidColorBrush x:Key="Studio.CyanBrush" Color="{StaticResource StudioAccentCyan}" />
    <SolidColorBrush x:Key="Studio.OnAccentBrush" Color="{StaticResource StudioOnAccent}" />
    <SolidColorBrush x:Key="Studio.SuccessBrush" Color="{StaticResource StudioSuccess}" />
    <SolidColorBrush x:Key="Studio.CautionBrush" Color="{StaticResource StudioCaution}" />
    <SolidColorBrush x:Key="Studio.CriticalBrush" Color="{StaticResource StudioCritical}" />
    <SolidColorBrush x:Key="Studio.SuccessSurfaceBrush" Color="{StaticResource StudioDarkSuccessSurface}" />
    <SolidColorBrush x:Key="Studio.CautionSurfaceBrush" Color="{StaticResource StudioDarkCautionSurface}" />
    <SolidColorBrush x:Key="Studio.CriticalSurfaceBrush" Color="{StaticResource StudioDarkCriticalSurface}" />
    <SolidColorBrush x:Key="Studio.InfoSurfaceBrush" Color="{StaticResource StudioDarkInfoSurface}" />
    <SolidColorBrush x:Key="Studio.FaderCapBrush" Color="{StaticResource StudioDarkRaised}" />
    <SolidColorBrush x:Key="Studio.SwitchOffBrush" Color="{StaticResource StudioDarkTrack}" />
    <SolidColorBrush x:Key="Studio.Channel.Microphone" Color="{StaticResource StudioChannelMic}" />
    <SolidColorBrush x:Key="Studio.Channel.Game" Color="{StaticResource StudioChannelGame}" />
    <SolidColorBrush x:Key="Studio.Channel.Chat" Color="{StaticResource StudioChannelChat}" />
    <SolidColorBrush x:Key="Studio.Channel.Media" Color="{StaticResource StudioChannelMedia}" />
    <SolidColorBrush x:Key="Studio.Channel.Aux" Color="{StaticResource StudioChannelAux}" />
    <SolidColorBrush x:Key="Studio.Channel.Master" Color="{StaticResource StudioChannelMaster}" />

    <LinearGradientBrush x:Key="Studio.CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource StudioDarkCardTop}" Offset="0" />
        <GradientStop Color="{StaticResource StudioDarkCard}" Offset="1" />
    </LinearGradientBrush>
    <!-- Buttons and filled controls: violet range only, so white text keeps its contrast. -->
    <LinearGradientBrush x:Key="Studio.AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource StudioAccentDeep}" Offset="0" />
        <GradientStop Color="{StaticResource StudioAccent}" Offset="1" />
    </LinearGradientBrush>
    <!-- Decorative only (rules, rings, meters): violet to cyan. -->
    <LinearGradientBrush x:Key="Studio.SignatureBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource StudioAccent}" Offset="0" />
        <GradientStop Color="{StaticResource StudioAccentCyan}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Studio.MeterBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="{StaticResource StudioSuccess}" Offset="0" />
        <GradientStop Color="{StaticResource StudioSuccess}" Offset="0.62" />
        <GradientStop Color="{StaticResource StudioCaution}" Offset="0.84" />
        <GradientStop Color="{StaticResource StudioCritical}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Studio.MeterHorizontalBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource StudioSuccess}" Offset="0" />
        <GradientStop Color="{StaticResource StudioSuccess}" Offset="0.62" />
        <GradientStop Color="{StaticResource StudioCaution}" Offset="0.84" />
        <GradientStop Color="{StaticResource StudioCritical}" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Studio.GlowVioletBrush" Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="{StaticResource StudioDarkGlowViolet}" Offset="0" />
        <GradientStop Color="Transparent" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Studio.GlowCyanBrush" Center="1,1" GradientOrigin="1,1" RadiusX="0.7" RadiusY="0.8">
        <GradientStop Color="{StaticResource StudioDarkGlowCyan}" Offset="0" />
        <GradientStop Color="Transparent" Offset="1" />
    </RadialGradientBrush>

    <!-- Shared Fluent keys re-pointed at the Studio palette (every standard control follows). -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource StudioDarkBase}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource StudioDarkRail}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource StudioDarkCard}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource StudioDarkStroke}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource StudioDarkText}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource StudioDarkTextSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource StudioDarkTextTertiary}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource StudioDarkHover}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource StudioDarkStroke}" />
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="{StaticResource StudioDarkSmoke}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource StudioAccent}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource StudioAccentBright}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource StudioAccentDeep}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource StudioAccentBright}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource StudioOnAccent}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{StaticResource StudioDarkSuccessSurface}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{StaticResource StudioDarkCautionSurface}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{StaticResource StudioDarkCriticalSurface}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{StaticResource StudioDarkInfoSurface}" />
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
</ResourceDictionary>
