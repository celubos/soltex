<UserControl x:Class="Soltex.App.Views.WindowsMixerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Soltex.App.Views" xmlns:audio="clr-namespace:Soltex.Audio.UI;assembly=Soltex.Audio.UI" xmlns:controls="clr-namespace:Soltex.App.Controls">
  <UserControl.Resources>
    <!-- The app's 8 px control radius would draw this check box as a circle that reads as a radio button. (A ticked box
         uses the app's accent: see AudioTheme.UseHostCheckBoxAccent in the constructor.) -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Style.Resources><CornerRadius x:Key="ControlCornerRadius">4</CornerRadius></Style.Resources>
      <Setter Property="Border.CornerRadius" Value="4"/>
    </Style>
    <DataTemplate x:Key="TrimmedLabel"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  </UserControl.Resources>
  <!-- The Audio page is the scroll host. The device row and the app rows share one card and one column layout
       (name, slider, value, mute) so their controls line up. Narrow windows put the name on its own line. -->
  <StackPanel Margin="0,0,0,8">
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="App volume" Style="{StaticResource Shell.SectionTitle}" Margin="0"/>
      <TextBlock Text="Volume and output for each app. Choosing a device here only changes what is shown; Windows defaults stay as they are." Style="{StaticResource Shell.Secondary}" Margin="0,4,0,0"/>
    </StackPanel>
    <audio:ResponsiveRow MinPrimaryWidth="220" Spacing="16" Margin="0,0,0,16">
      <StackPanel MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <TextBlock Text="Playback device" Style="{StaticResource Studio.Eyebrow}" Margin="0,0,0,6"/>
        <ComboBox x:Name="DeviceSelector" ItemTemplate="{StaticResource TrimmedLabel}" SelectedValuePath="Id" SelectionChanged="DeviceChanged" MinHeight="36"
                  AutomationProperties.Name="Playback device to show" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
      </StackPanel>
      <CheckBox x:Name="ShowVirtual" Content="Include virtual playback devices" VerticalAlignment="Bottom" Margin="0,0,0,8" Checked="VirtualVisibilityChanged" Unchecked="VirtualVisibilityChanged"/>
    </audio:ResponsiveRow>
    <Border x:Name="SessionCard" Style="{StaticResource Shell.Card}" Padding="20,6,20,10">
      <StackPanel>
        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,12">
          <Grid x:Name="DeviceRow">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="DeviceName" Text="Device volume" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Slider x:Name="EndpointLevel" Grid.Column="1" Margin="0,0,16,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" VerticalAlignment="Center" ValueChanged="EndpointLevelChanged" PreviewMouseWheel="IgnoreWheel" AutomationProperties.Name="Playback device volume percent"/>
            <StackPanel x:Name="DeviceValue" Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="EndpointValue" Width="56" TextAlignment="Center" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="%" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="EndpointMute" Grid.Column="3" Content="Mute" Click="EndpointMuteClick" Padding="10,6" MinWidth="80" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            <audio:SignalMeter x:Name="EndpointPeak" Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Thickness="4" Margin="0,12,0,0" IsHitTestVisible="False"
                               Fill="{DynamicResource Studio.MeterHorizontalBrush}" Track="{DynamicResource Studio.TrackBrush}" AutomationProperties.Name="Playback device level"/>
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="AppName" Text="{Binding Name}" ToolTip="{Binding Details}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" VerticalAlignment="Center"/>
              <Slider x:Name="AppLevel" Grid.Column="1" Value="{Binding Level,Mode=OneWay}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" VerticalAlignment="Center" IsEnabled="{Binding CanControl}" ValueChanged="SessionLevelChanged" PreviewMouseWheel="IgnoreWheel" AutomationProperties.Name="{Binding AccessibleName}" Margin="0,0,16,0"/>
              <StackPanel x:Name="AppValue" Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBox Width="56" Text="{Binding LevelText,Mode=OneWay}" TextAlignment="Center" IsEnabled="{Binding CanControl}" GotKeyboardFocus="LevelFocus" LostKeyboardFocus="LevelCommit" KeyDown="LevelKey" AutomationProperties.Name="{Binding AccessibleName}" VerticalContentAlignment="Center"/>
                <TextBlock Text="%" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <Button x:Name="AppMute" Grid.Column="3" Content="{Binding MuteLabel}" IsEnabled="{Binding CanControl}" Click="SessionMuteClick" Padding="10,6" MinWidth="80" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="{Binding MuteAccessibleName}"/>
              <TextBlock x:Name="AppStatus" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status}" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,8,12,0" VerticalAlignment="Center"/>
              <Button x:Name="AppRoute" Grid.Row="1" Grid.Column="3" Content="Route…" IsEnabled="{Binding CanRoute}" Click="SessionRouteClick" Padding="10,4" MinHeight="0" Margin="0,8,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding RouteAccessibleName}" ToolTip="Send this app to another output"/>
              <audio:SignalMeter Grid.Row="4" Grid.ColumnSpan="4" Level="{Binding Peak,Mode=OneWay}" Orientation="Horizontal" Thickness="4" Margin="0,12,0,0" IsHitTestVisible="False"
                                 Fill="{DynamicResource Studio.MeterHorizontalBrush}" Track="{DynamicResource Studio.TrackBrush}" AutomationProperties.Name="{Binding MeterAccessibleName}"/>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <!-- Narrow: the name gets its own line and the controls move below it. -->
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:WindowsMixerView}}" Value="True">
              <Setter TargetName="AppName" Property="Grid.ColumnSpan" Value="4"/>
              <Setter TargetName="AppName" Property="Margin" Value="0,0,0,8"/>
              <Setter TargetName="AppLevel" Property="Grid.Row" Value="1"/>
              <Setter TargetName="AppLevel" Property="Grid.Column" Value="0"/>
              <Setter TargetName="AppLevel" Property="Grid.ColumnSpan" Value="3"/>
              <Setter TargetName="AppValue" Property="Grid.Row" Value="1"/>
              <Setter TargetName="AppValue" Property="Grid.Column" Value="3"/>
              <Setter TargetName="AppValue" Property="Margin" Value="0"/>
              <Setter TargetName="AppMute" Property="Grid.Row" Value="2"/>
              <Setter TargetName="AppMute" Property="Margin" Value="0,8,0,0"/>
              <Setter TargetName="AppStatus" Property="Grid.Row" Value="2"/>
              <Setter TargetName="AppRoute" Property="Grid.Row" Value="3"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock x:Name="EmptySessions" Text="Play something in an app to see it here." Style="{StaticResource Shell.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,8"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="Feedback" Text="Choose a playback device." Style="{StaticResource Shell.Secondary}" Margin="2,0,0,0" controls:LiveRegion.IsLive="True"/>
    <TextBlock Text="To move an app to another output, use its Route… button." Style="{StaticResource Shell.Secondary}" Margin="2,6,0,0"/>
  </StackPanel>
</UserControl>
