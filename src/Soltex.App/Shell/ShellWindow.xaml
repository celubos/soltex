<Window x:Class="Soltex.App.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Soltex.App"
        Title="{x:Static app:ProductIdentity.DisplayName}" Width="1180" Height="780" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid x:Name="ScaleRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- Navigation pane. The footer is declared before the main list so the main list fills the rest;
             TabIndex keeps keyboard order the same as the visual order (search, pages, then History and Settings). -->
        <DockPanel Grid.Column="0" Margin="10,18,6,14">
            <TextBlock x:Name="ProductNameText" DockPanel.Dock="Top" Text="{x:Static app:ProductIdentity.DisplayName}" FontSize="16" FontWeight="SemiBold"
                       Margin="16,4,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Button x:Name="SearchButton" DockPanel.Dock="Top" KeyboardNavigation.TabIndex="0" Margin="6,0,6,16" Padding="14,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Search settings and tools" AutomationProperties.AcceleratorKey="Ctrl+K"
                    ToolTip="Search settings and tools (Ctrl+K)" Click="SearchButton_Click">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Shell.Glyph}" Text="&#xE721;" Margin="0,0,10,0" FontSize="14" />
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Search" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <ListBox x:Name="FooterNav" DockPanel.Dock="Bottom" KeyboardNavigation.TabIndex="2" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource Shell.NavItem}" ItemTemplate="{StaticResource Shell.NavItemTemplate}"
                     AutomationProperties.Name="App settings" SelectionChanged="Nav_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <ListBox x:Name="PrimaryNav" KeyboardNavigation.TabIndex="1" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource Shell.NavItem}" ItemTemplate="{StaticResource Shell.NavItemTemplate}"
                     AutomationProperties.Name="Main navigation" SelectionChanged="Nav_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>

        <!-- Page area -->
        <Border Grid.Column="1" Background="Transparent" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="NoticeBar" Style="{StaticResource Shell.InfoBar}" Visibility="Collapsed" Margin="36,18,36,0"
                        AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Notice">
                    <DockPanel>
                        <Button x:Name="NoticeClose" DockPanel.Dock="Right" Padding="8,4" Margin="8,0,0,0" Click="NoticeClose_Click"
                                AutomationProperties.Name="Dismiss notice" ToolTip="Dismiss">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE711;" FontSize="12" />
                        </Button>
                        <Button x:Name="NoticeAction" DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" Visibility="Collapsed" Click="NoticeAction_Click" />
                        <TextBlock x:Name="NoticeGlyph" DockPanel.Dock="Left" Style="{StaticResource Shell.Glyph}" Text="&#xE946;" Margin="0,0,10,0" />
                        <TextBlock x:Name="NoticeText" Style="{StaticResource Shell.Body}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" IsTabStop="False" />
            </Grid>
        </Border>

        <!-- Search overlay -->
        <Grid x:Name="SearchOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="{DynamicResource SmokeFillColorDefaultBrush}" MouseDown="SearchOverlay_MouseDown">
            <Border Style="{StaticResource Shell.Card}" Width="580" VerticalAlignment="Top" Margin="0,64,0,0"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" MouseDown="SearchCard_MouseDown">
                <StackPanel>
                    <TextBox x:Name="SearchBox" FontSize="15" Padding="10,8" AutomationProperties.Name="Search settings and tools"
                             AutomationProperties.HelpText="Type a word such as microphone, theme, scan or start. Use the arrow keys and Enter."
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock x:Name="SearchHint" Style="{StaticResource Shell.Secondary}" Margin="2,10,2,2"
                               Text="Try: microphone, dark mode, scan a file, start at sign-in, remote help." />
                    <ListBox x:Name="SearchResults" Margin="0,8,0,0" MaxHeight="360" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Search results" MouseUp="SearchResults_MouseUp" KeyDown="SearchResults_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Location}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Location}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
