<Window x:Class="Soltex.App.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Soltex.App"
        xmlns:controls="clr-namespace:Soltex.App.Controls"
        Title="{x:Static app:ProductIdentity.DisplayName}" Width="1180" Height="780" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid x:Name="ScaleRoot" SizeChanged="ScaleRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- Navigation pane. The footer is declared before the main list so the main list fills the rest;
             TabIndex keeps keyboard order the same as the visual order (search, pages, then History and Settings).
             When the page would get too narrow (a small window or a large text scale) the pane becomes an icon rail:
             the labels move into tooltips and the accessible names stay. When the window is short the items get
             shorter (and the product name steps aside) so every page still fits; only when even that is not enough does
             the page list scroll, with the selected page kept in view and the items clear of the scroll bar. -->
        <DockPanel x:Name="Rail" Grid.Column="0" Margin="10,18,6,14">
            <TextBlock x:Name="ProductNameText" DockPanel.Dock="Top" Text="{x:Static app:ProductIdentity.DisplayName}" FontSize="16" FontWeight="SemiBold"
                       Margin="16,4,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Button x:Name="SearchButton" DockPanel.Dock="Top" KeyboardNavigation.TabIndex="0" Margin="6,0,6,16" Padding="14,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Search settings and tools" AutomationProperties.AcceleratorKey="Ctrl+K"
                    ToolTip="Search settings and tools (Ctrl+K)" Click="SearchButton_Click">
                <DockPanel>
                    <TextBlock x:Name="SearchGlyph" DockPanel.Dock="Left" Style="{StaticResource Shell.Glyph}" Text="&#xE721;" Margin="0,0,10,0" FontSize="14" />
                    <TextBlock x:Name="SearchShortcut" DockPanel.Dock="Right" Text="Ctrl+K" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SearchLabel" Text="Search" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <ListBox x:Name="FooterNav" DockPanel.Dock="Bottom" KeyboardNavigation.TabIndex="2" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource Shell.NavItem}" ItemTemplate="{StaticResource Shell.NavItemTemplate}"
                     AutomationProperties.Name="App settings" SelectionChanged="Nav_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
            <Border x:Name="FooterRule" DockPanel.Dock="Bottom" Style="{StaticResource Shell.RailRule}" />
            <ListBox x:Name="PrimaryNav" KeyboardNavigation.TabIndex="1" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource Shell.NavItem}" ItemTemplate="{StaticResource Shell.NavItemTemplate}"
                     AutomationProperties.Name="Main navigation" SelectionChanged="Nav_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.ScrollChanged="PrimaryNav_ScrollChanged" />
        </DockPanel>

        <!-- Page area -->
        <Border Grid.Column="1" Background="Transparent" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- The notice text is a live region: Narrator reads each notice when it appears (ShowNotice). -->
                <Border x:Name="NoticeBar" Style="{StaticResource Shell.InfoBar}" Visibility="Collapsed" Margin="24,18,24,0">
                    <DockPanel>
                        <Button x:Name="NoticeClose" DockPanel.Dock="Right" Padding="8,4" Margin="8,0,0,0" Click="NoticeClose_Click"
                                AutomationProperties.Name="Dismiss notice" ToolTip="Dismiss">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE711;" FontSize="12" />
                        </Button>
                        <Button x:Name="NoticeAction" DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" Visibility="Collapsed" Click="NoticeAction_Click" />
                        <TextBlock x:Name="NoticeGlyph" DockPanel.Dock="Left" Style="{StaticResource Shell.Glyph}" Text="&#xE946;" Margin="0,0,10,0" />
                        <TextBlock x:Name="NoticeText" Style="{StaticResource Shell.Body}" VerticalAlignment="Center" controls:LiveRegion.IsLive="True" />
                    </DockPanel>
                </Border>
                <!-- Every page fills the page area, so its scroll bar sits at the window edge and its content column (capped by
                     the page at Shell.PageMaxWidth) starts and ends at the same place on every page. Scrolls sideways only
                     when the page area is narrower than any page can use (a very large text scale in a small window); the
                     page's own scrolling stays vertical inside it. -->
                <ScrollViewer x:Name="PageViewport" Grid.Row="1" Focusable="False" IsTabStop="False"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Search overlay. Tab and Ctrl+Tab cycle between the box and the results and never reach the page underneath;
             Escape or a click outside closes it. -->
        <Grid x:Name="SearchOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="{DynamicResource SmokeFillColorDefaultBrush}" MouseDown="SearchOverlay_MouseDown">
            <Border x:Name="SearchCard" Style="{StaticResource Shell.Card}" MaxWidth="580" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,64,16,0"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" MouseDown="SearchCard_MouseDown"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBox x:Name="SearchBox" FontSize="15" Padding="10,8" AutomationProperties.Name="Search settings and tools"
                             AutomationProperties.HelpText="Type a word such as microphone, theme, scan or start. Use the arrow keys and Enter."
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock x:Name="SearchHint" Style="{StaticResource Shell.Secondary}" Margin="2,10,2,2" controls:LiveRegion.IsLive="True"
                               Text="Try: microphone, dark mode, scan a file, start at sign-in, remote help." />
                    <ListBox x:Name="SearchResults" Margin="0,8,0,0" MaxHeight="360" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Search results" MouseUp="SearchResults_MouseUp" KeyDown="SearchResults_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource Shell.SearchResultItem}" ItemTemplate="{StaticResource Shell.SearchResultTemplate}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
