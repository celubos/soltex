<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Soltex.Audio.Engine.Core</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Description>Independent PCM DSP and explicit WASAPI bridge; requires separately supplied audio endpoints.</Description>
    <!-- LibraryImport string marshalling for the MMCSS registration (avrt.dll). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Soltex.Audio.Engine.Tests" />
    <!-- MMCSS scheduler seam for the owned worker thread checks. -->
    <InternalsVisibleTo Include="Soltex.Audio.OwnedEndpoints.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- RNNoise 0.2, built by native/Soltex.Rnnoise/build.ps1 into artifacts/native/rnnoise. It sits next to
       Soltex.Audio.Engine.Core.dll in every application, host and test that references this project; without it neural
       noise removal reports itself unavailable and passes audio through. -->
  <PropertyGroup>
    <SoltexRnnoise>$(MSBuildThisFileDirectory)..\..\artifacts\native\rnnoise\x64\soltex-rnnoise.dll</SoltexRnnoise>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SoltexRnnoise)" Link="soltex-rnnoise.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(SoltexRnnoise)')" />
  </ItemGroup>
</Project>
